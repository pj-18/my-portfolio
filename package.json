{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio: work, films, photography, chess. Static site built with Astro.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/sync.ts --if-stale && astro dev",
    "build": "node scripts/sync.ts && astro build",
    "preview": "astro preview",
    "sync": "node scripts/sync.ts",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "placeholders": "node scripts/placeholders.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.19.2",
    "astro": "^7.4.10",
    "chess.js": "^1.4.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.12.0",
    "fontkit": "^2.0.4",
    "node-html-parser": "^9.0.7",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
