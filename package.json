{
  "name": "pj-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Praveen Ponduru (PJ): code by day, cinema by night, frames in between.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/sync-letterboxd.ts --if-missing && node scripts/sync-music.ts --if-missing",
    "dev": "astro dev",
    "films": "node scripts/sync-letterboxd.ts",
    "music": "node scripts/sync-music.ts",
    "music:sample": "node scripts/sync-music.ts --sample",
    "build": "node scripts/sync-letterboxd.ts && node scripts/sync-music.ts && astro build",
    "build:offline": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "photos:placeholders": "node scripts/make-placeholder-photos.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.4.13",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.4",
    "typescript": "^6.0.3"
  }
}
