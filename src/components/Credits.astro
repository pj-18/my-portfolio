---
import Icon from './Icon.astro';
import { site } from '../site.config';
import { diary, filmUrl, poster, recommendations } from '../lib/films';
import { dayMonthYear, safeJson } from '../lib/util';

const year = new Date().getFullYear();
const link = (label: string) => site.links.find((l) => l.label === label);
const letterboxd = link('Letterboxd');
const github = link('GitHub');

const credits: { role: string; name: string; href?: string }[] = [
  { role: 'Written & directed by', name: site.name },
  { role: 'Also known as', name: site.nickname },
  { role: 'Day job', name: site.role },
  { role: 'Film critic', name: `@${site.letterboxd} on Letterboxd`, href: letterboxd?.url },
  { role: 'Cinematography', name: `${site.nickname}, one frame at a time` },
  { role: 'Source code', name: github ? `github.com/${github.handle}` : 'GitHub', href: github?.url },
  { role: 'Typefaces', name: 'Archivo, Instrument Serif, JetBrains Mono' },
  { role: 'Built with', name: 'Astro and a little vanilla JS' },
];

const reel = recommendations.map((e) => {
  const art = poster(e.poster);
  return {
    title: e.title,
    year: e.year,
    rating: e.rating,
    liked: e.liked,
    src: art?.src ?? null,
    srcset: art?.srcset ?? null,
    url: filmUrl(e),
    take: e.review[0]?.replace(/\s*\n\s*/g, ' ') ?? null,
  };
});
const mail = Array.from({ length: 4 });
---

<section id="credits" class="credits" data-scene="credits" aria-labelledby="credits-title">
  <div class="wrap credits__fin">
    <p class="credits__end reveal" aria-hidden="true">Fin.</p>
    <h2 id="credits-title" class="credits__title reveal">
      Thanks for watching. <span>The sequel starts with an email.</span>
    </h2>
  </div>

  <a class="mailband" href={`mailto:${site.email}`} aria-label={`Email ${site.name} at ${site.email}`}>
    <span class="mailband__track" aria-hidden="true">
      {
        mail.map(() => (
          <span class="mailband__item">
            Say hello <i>✳</i> {site.email} <i>✳</i>
          </span>
        ))
      }
    </span>
  </a>

  <div class="wrap contact">
    <button type="button" class="pill pill--solid accent-amber" data-copy={site.email}>
      <Icon name="copy" />
      <span data-copy-label>Copy email</span>
    </button>
    {
      site.links.map((item) => (
        <a class="pill" href={item.url} target="_blank" rel="me noopener noreferrer">
          {item.label} <Icon name="arrow" />
        </a>
      ))
    }
  </div>

  <dl class="wrap rolling">
    {
      credits.map((credit) => (
        <div class="rolling__row reveal">
          <dt>{credit.role}</dt>
          <dd>
            {credit.href ? (
              <a href={credit.href} target="_blank" rel="noopener noreferrer">
                {credit.name}
              </a>
            ) : (
              credit.name
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  {
    reel.length > 0 && (
      <aside class="wrap post" aria-labelledby="post-title">
        <p class="eyebrow post__kicker">
          <span /> Post-credits scene
        </p>
        <h3 id="post-title" class="post__title">Can't pick tonight's film?</h3>
        <p class="post__text">
          Spin the reel. It only stops on films I loved or rated three and a half stars or more.
        </p>
        <div class="spinner" data-spinner>
          <div class="spinner__gate" aria-hidden="true">
            <img data-spin-img alt="" width="300" height="450" hidden />
            <span class="spinner__leader">?</span>
          </div>
          <div class="spinner__result" aria-live="polite" data-spin-result>
            <p class="spinner__idle">The projector is loaded. Press the button.</p>
          </div>
        </div>
        <button type="button" class="pill pill--solid accent-amber post__spin" data-spin>
          <Icon name="shuffle" /> Spin the reel
        </button>
        <script type="application/json" id="reel-data" is:inline set:html={safeJson(reel)} />
      </aside>
    )
  }

  <footer class="wrap colophon">
    <p>© {year} {site.name}</p>
    {diary.fetchedAt && <p>Film diary synced {dayMonthYear(diary.fetchedAt)}</p>}
    <a href="#top">Back to the top ↑</a>
  </footer>
</section>

<style>
  .credits {
    position: relative;
    padding-top: clamp(5rem, 16vw, 10rem);
  }

  .credits__fin {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .credits__end {
    font-family: var(--f-serif);
    font-size: clamp(6rem, 34vw, 15rem);
    font-style: italic;
    line-height: 0.8;
    color: var(--paper);
  }

  .credits__title {
    max-width: 22ch;
    font-size: clamp(1.35rem, 5.4vw, 2.2rem);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  .credits__title span {
    color: var(--muted);
  }

  /* ---- giant email marquee ---- */

  .mailband {
    display: block;
    margin-top: clamp(3rem, 9vw, 5rem);
    overflow: hidden;
    padding-block: 1.1rem 0.9rem;
    border-block: 1px solid var(--line);
    background: var(--amber);
    color: var(--ink);
    text-decoration: none;
  }

  .mailband__track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .mailband:hover .mailband__track {
    animation-play-state: paused;
  }

  .mailband__item {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding-right: 0.3em;
    font-family: var(--f-display);
    font-size: clamp(3rem, 14vw, 8.5rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 0.9;
    white-space: nowrap;
  }

  .mailband__item i {
    font-size: 0.5em;
    font-style: normal;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  /* ---- rolling credits ---- */

  .rolling {
    display: grid;
    gap: 1.6rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    text-align: center;
  }

  .rolling__row {
    display: grid;
    gap: 0.3rem;
  }

  .rolling dt {
    font-family: var(--f-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rolling dd {
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-stretch: 75%;
    font-weight: 700;
    line-height: 1.15;
  }

  .rolling a {
    text-decoration-color: rgb(255 182 39 / 0.5);
    text-underline-offset: 0.18em;
  }

  .rolling a:hover {
    color: var(--amber);
  }

  /* ---- post-credits scene ---- */

  .post {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: clamp(5rem, 14vw, 9rem);
    padding: 2rem 1.25rem;
    border: 1px dashed var(--line-2);
    border-radius: var(--radius);
    text-align: center;
  }

  .post__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post__kicker span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
  }

  .post__title {
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 10vw, 3.6rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .post__text {
    max-width: 34ch;
    color: var(--muted);
  }

  .spinner {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    width: 100%;
    margin-block: 0.5rem 0.25rem;
  }

  .spinner__gate {
    position: relative;
    display: grid;
    place-items: center;
    width: 8.5rem;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle, transparent 38%, rgb(243 234 216 / 0.14) 39%, transparent 40%),
      repeating-linear-gradient(0deg, var(--ink-3) 0 6px, var(--ink-2) 6px 12px);
    box-shadow:
      0 0 0 6px var(--ink-2),
      0 0 0 7px var(--line-2),
      0 24px 40px -18px rgb(0 0 0 / 0.9);
  }

  .spinner__gate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* the strip of posters that rolls through the gate while spinning */
  .spinner__gate :global(.spinner__reel) {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    flex-direction: column;
    will-change: transform, filter;
  }

  .spinner__gate :global(.spinner__reel[hidden]) {
    display: none;
  }

  .spinner__gate :global(.spinner__reel img) {
    position: static;
    flex: none;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: var(--ink-3);
  }

  /* gate shadow so the frames read as passing behind the aperture */
  .spinner__gate::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: linear-gradient(rgb(0 0 0 / 0.55), transparent 22%, transparent 78%, rgb(0 0 0 / 0.55));
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .spinner.is-spinning .spinner__gate::after {
    opacity: 1;
  }

  .spinner__leader {
    font-family: var(--f-display);
    font-size: 4rem;
    font-stretch: 62%;
    font-weight: 850;
    color: var(--dim);
  }

  .spinner__result {
    display: grid;
    gap: 0.35rem;
    min-height: 5.5rem;
    max-width: 32ch;
  }

  .spinner__idle {
    color: var(--dim);
    font-family: var(--f-serif);
    font-size: 1.2rem;
    font-style: italic;
  }

  .spinner__result :global(.spin-title) {
    font-family: var(--f-display);
    font-size: 1.9rem;
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .spinner__result :global(.spin-title span) {
    color: var(--muted);
    font-weight: 500;
  }

  .spinner__result :global(.spin-stars) {
    color: var(--amber);
    line-height: 1;
  }

  .spinner__result :global(.spin-heart) {
    margin-left: 0.5em;
    color: var(--red);
  }

  .spinner__result :global(.spin-take) {
    font-family: var(--f-serif);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--paper-dim);
  }

  .spinner__result :global(.spin-link) {
    justify-self: center;
    margin-top: 0.3rem;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
  }

  /* ---- colophon ---- */

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .colophon a {
    color: var(--muted);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .rolling {
      gap: 1.1rem;
    }

    .rolling__row {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
      gap: 2rem;
    }

    .rolling dt {
      text-align: right;
    }

    .rolling dd {
      text-align: left;
    }

    .post {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      align-items: center;
      gap: 1rem 2.5rem;
      padding: 2.5rem;
      text-align: left;
    }

    .post > :not(.spinner) {
      grid-column: 2;
    }

    .spinner {
      grid-column: 1;
      grid-row: 1 / span 5;
      justify-items: center;
    }

    .spinner__result :global(.spin-link) {
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mailband__track {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/credits';
</script>
