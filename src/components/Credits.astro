---
import Icon from './Icon.astro';
import { site } from '../site.config';
import { brands, brandFills } from '../lib/brands';
import { diary } from '../lib/films';
import { headliners, music } from '../lib/music';
import { dayMonthYear, withBase } from '../lib/util';
import { tours } from '../lib/tours-data';

const year = new Date().getFullYear();
const link = (label: string) => site.links.find((l) => l.label === label);
const letterboxd = link('Letterboxd');
const github = link('GitHub');
const instagram = link('Instagram (photography)');
const instagramPersonal = link('Instagram (personal)');

// `here` links stay on this site, so they open in the same tab.
const credits: { role: string; name: string; href?: string; here?: boolean }[] = [
  { role: 'Written & directed by', name: site.name },
  { role: 'Also known as', name: site.nickname },
  { role: 'Day job', name: site.role },
  ...(tours.length ? [{ role: 'On location', name: 'Tours, day by day', href: withBase('tours/'), here: true }] : []),
  { role: 'Film critic', name: `@${site.letterboxd} on Letterboxd`, href: letterboxd?.url },
  ...(music && headliners() ? [{ role: 'Music by', name: `${headliners()}, on repeat`, href: music.profile }] : []),
  { role: 'Cinematography', name: '@frames.by.pj on Instagram', href: instagram?.url },
  { role: 'Behind the scenes', name: '@urstruly.pj on Instagram', href: instagramPersonal?.url },
  { role: 'Source code', name: github ? `github.com/${github.handle}` : 'GitHub', href: github?.url },
  { role: 'Typefaces', name: 'Archivo, Instrument Serif, JetBrains Mono' },
  { role: 'Built with', name: 'Astro and a little vanilla JS' },
];
// The address is only put together in the browser (scripts/credits.ts), so it's never in the HTML.
const { user, domain } = site.email;

// Mail first, then the socials in this order (anything not listed follows).
const order = ['Instagram', 'Letterboxd', 'LinkedIn', 'GitHub'];
const rank = (brand: string) => (order.includes(brand) ? order.indexOf(brand) : order.length);
// `brand` (logo key) defaults to the label; it differs when one service has several accounts.
// The sort is stable, so the two Instagram accounts keep their order from the config.
const contacts: { label: string; brand: string; url: string; mail?: boolean }[] = [
  { label: 'Mail', brand: 'Mail', url: '#credits', mail: true },
  ...site.links
    .filter((l) => l.label !== 'Instagram (photography)') // lives in the photos section
    .map((l) => ({ label: l.label, brand: ('brand' in l ? l.brand : l.label) as string, url: l.url }))
    .sort((a, b) => rank(a.brand) - rank(b.brand)),
];
---

<section id="credits" class="credits" data-scene="credits" aria-labelledby="credits-title">
  <div class="wrap credits__fin">
    <p class="credits__end reveal" aria-hidden="true">Fin.</p>
    <h2 id="credits-title" class="credits__title reveal">
      Thanks for watching. <span>The sequel starts with an email.</span>
    </h2>
  </div>

  <div class="wrap contact">
    {
      contacts.map((item, i) => {
        const fill = brandFills[item.brand];
        const gid = `grad-${i}`;
        const gradient = typeof fill === 'object' ? fill : undefined;
        return (
        <a
          class:list={['pill', brands[item.brand] && 'pill--logo']}
          href={item.url}
          target={item.mail ? undefined : '_blank'}
          rel={item.mail ? undefined : 'me noopener noreferrer'}
          aria-label={item.mail ? `Email ${site.name}` : item.label}
          title={item.mail ? 'Say hello' : item.label}
          data-mail={item.mail ? '' : undefined}
          data-mail-user={item.mail ? user : undefined}
          data-mail-domain={item.mail ? domain : undefined}
        >
          {brands[item.brand] ? (
            <svg class="pill__logo" viewBox="0 0 24 24" width="2.5em" height="2.5em" aria-hidden="true" focusable="false">
              {gradient && (
                <defs>
                  <linearGradient
                    id={gid}
                    gradientUnits="userSpaceOnUse"
                    x1={gradient.angle === 'across' ? 0 : 2}
                    y1={gradient.angle === 'across' ? 0 : 24}
                    x2={gradient.angle === 'across' ? 24 : 22}
                    y2={gradient.angle === 'across' ? 0 : 0}
                  >
                    {gradient.stops.map(([offset, color]) => (
                      <stop offset={`${offset}%`} stop-color={color} />
                    ))}
                  </linearGradient>
                </defs>
              )}
              <path d={brands[item.brand]}fill={gradient ? `url(#${gid})` : (fill as string)} />
            </svg>
          ) : (
            <>
              {item.label} <Icon name="arrow" />
            </>
          )}
        </a>
        );
      })
    }
  </div>

  <dl class="wrap rolling">
    {
      credits.map((credit) => (
        <div class="rolling__row reveal">
          <dt>{credit.role}</dt>
          <dd>
            {credit.href && credit.here ? (
              <a href={credit.href}>{credit.name} →</a>
            ) : credit.href ? (
              <a href={credit.href} target="_blank" rel="noopener noreferrer">
                {credit.name}
              </a>
            ) : (
              credit.name
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <footer class="wrap colophon">
    <p>© {year} {site.name}</p>
    {diary.fetchedAt && <p>Film diary synced {dayMonthYear(diary.fetchedAt)}</p>}    <a href="#top">Back to the top ↑</a>
  </footer>
</section>

<style>
  .credits {
    position: relative;
    padding-top: clamp(1.5rem, 5vw, 3rem);
  }

  .credits__fin {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .credits__end {
    font-family: var(--f-serif);
    font-size: clamp(6rem, 34vw, 15rem);
    font-style: italic;
    line-height: 0.8;
    color: var(--paper);
  }

  .credits__title {
    max-width: 22ch;
    font-size: clamp(1.35rem, 5.4vw, 2.2rem);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  .credits__title span {
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 8vw, 4rem);
  }

  /* Logos keep their own colours, on a paper-white disc so the dark ones (GitHub) still show. */
  .pill--logo {
    width: 72px;
    height: 72px;
    padding: 0;
    border-color: transparent;
    background: var(--paper);
    font-size: 1rem;
  }

  .pill--logo:hover {
    border-color: var(--cobalt);
    transform: translateY(-2px);
  }

  .pill__logo {
    flex: none;
  }

  /* ---- rolling credits ---- */

  .rolling {
    display: grid;
    gap: 1.6rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    text-align: center;
  }

  .rolling__row {
    display: grid;
    gap: 0.3rem;
  }

  .rolling dt {
    font-family: var(--f-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rolling dd {
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-stretch: 75%;
    font-weight: 700;
    line-height: 1.15;
  }

  .rolling a {
    text-decoration-color: rgb(91 155 255 / 0.55);
    text-underline-offset: 0.18em;
  }

  .rolling a:hover {
    color: var(--cobalt);
  }

  /* ---- colophon ---- */

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .colophon a {
    color: var(--muted);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .rolling {
      gap: 1.1rem;
    }

    .rolling__row {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
      gap: 2rem;
    }

    .rolling dt {
      text-align: right;
    }

    .rolling dd {
      text-align: left;
    }
  }
</style>

<script>
  import '../scripts/credits';
</script>
