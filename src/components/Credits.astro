---
import Icon from './Icon.astro';
import { site } from '../site.config';
import { diary } from '../lib/films';
import { headliners, music } from '../lib/music';
import { dayMonthYear } from '../lib/util';

const year = new Date().getFullYear();
const link = (label: string) => site.links.find((l) => l.label === label);
const letterboxd = link('Letterboxd');
const github = link('GitHub');
const instagram = link('Instagram');

const credits: { role: string; name: string; href?: string }[] = [
  { role: 'Written & directed by', name: site.name },
  { role: 'Also known as', name: site.nickname },
  { role: 'Day job', name: site.role },
  { role: 'Film critic', name: `@${site.letterboxd} on Letterboxd`, href: letterboxd?.url },
  ...(music && headliners() ? [{ role: 'Music by', name: `${headliners()}, on repeat`, href: music.profile }] : []),
  { role: 'Cinematography', name: '@frames.by.pj on Instagram', href: instagram?.url },
  { role: 'Source code', name: github ? `github.com/${github.handle}` : 'GitHub', href: github?.url },
  { role: 'Typefaces', name: 'Archivo, Instrument Serif, JetBrains Mono' },
  { role: 'Built with', name: 'Astro and a little vanilla JS' },
];
const mail = Array.from({ length: 4 });
// The address is only put together in the browser (scripts/credits.ts); this is the no-JS spelling.
const { user, domain } = site.email;
const spelled = `${user} [at] ${domain}`;
---

<section id="credits" class="credits" data-scene="credits" aria-labelledby="credits-title">
  <div class="wrap credits__fin">
    <p class="credits__end reveal" aria-hidden="true">Fin.</p>
    <h2 id="credits-title" class="credits__title reveal">
      Thanks for watching. <span>The sequel starts with an email.</span>
    </h2>
  </div>

  <a
    class="mailband"
    href="#credits"
    data-mail
    data-mail-user={user}
    data-mail-domain={domain}
    aria-label={`Email ${site.name}: ${spelled}`}
  >
    <span class="mailband__track" aria-hidden="true">
      {
        mail.map(() => (
          <span class="mailband__item">
            Say hello <i>✳</i> <span data-mail-text>{spelled}</span> <i>✳</i>
          </span>
        ))
      }
    </span>
  </a>

  <div class="wrap contact">
    <button type="button" class="pill pill--solid accent-cobalt" data-copy-mail>
      <Icon name="copy" />
      <span data-copy-label>Copy email</span>
    </button>
    {
      site.links.map((item) => (
        <a class="pill" href={item.url} target="_blank" rel="me noopener noreferrer">
          {item.label} <Icon name="arrow" />
        </a>
      ))
    }
  </div>

  <dl class="wrap rolling">
    {
      credits.map((credit) => (
        <div class="rolling__row reveal">
          <dt>{credit.role}</dt>
          <dd>
            {credit.href ? (
              <a href={credit.href} target="_blank" rel="noopener noreferrer">
                {credit.name}
              </a>
            ) : (
              credit.name
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <footer class="wrap colophon">
    <p>© {year} {site.name}</p>
    {diary.fetchedAt && <p>Film diary synced {dayMonthYear(diary.fetchedAt)}</p>}    <a href="#top">Back to the top ↑</a>
  </footer>
</section>

<style>
  .credits {
    position: relative;
    padding-top: clamp(1.5rem, 5vw, 3rem);
  }

  .credits__fin {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .credits__end {
    font-family: var(--f-serif);
    font-size: clamp(6rem, 34vw, 15rem);
    font-style: italic;
    line-height: 0.8;
    color: var(--paper);
  }

  .credits__title {
    max-width: 22ch;
    font-size: clamp(1.35rem, 5.4vw, 2.2rem);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  .credits__title span {
    color: var(--muted);
  }

  /* ---- giant email marquee ---- */

  .mailband {
    display: block;
    margin-top: clamp(3rem, 9vw, 5rem);
    overflow: hidden;
    padding-block: 1.1rem 0.9rem;
    border-block: 1px solid var(--line);
    background: var(--cobalt);
    color: var(--ink);
    text-decoration: none;
  }

  .mailband__track {
    display: flex;
    width: max-content;
    animation: marquee 30s linear infinite;
  }

  .mailband:hover .mailband__track {
    animation-play-state: paused;
  }

  .mailband__item {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding-right: 0.3em;
    font-family: var(--f-display);
    font-size: clamp(3rem, 14vw, 8.5rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 0.9;
    white-space: nowrap;
  }

  .mailband__item i {
    font-size: 0.5em;
    font-style: normal;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  /* ---- rolling credits ---- */

  .rolling {
    display: grid;
    gap: 1.6rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    text-align: center;
  }

  .rolling__row {
    display: grid;
    gap: 0.3rem;
  }

  .rolling dt {
    font-family: var(--f-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rolling dd {
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-stretch: 75%;
    font-weight: 700;
    line-height: 1.15;
  }

  .rolling a {
    text-decoration-color: rgb(91 155 255 / 0.55);
    text-underline-offset: 0.18em;
  }

  .rolling a:hover {
    color: var(--cobalt);
  }

  /* ---- colophon ---- */

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .colophon a {
    color: var(--muted);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .rolling {
      gap: 1.1rem;
    }

    .rolling__row {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
      gap: 2rem;
    }

    .rolling dt {
      text-align: right;
    }

    .rolling dd {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mailband__track {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/credits';
</script>
