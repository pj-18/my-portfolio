---
import ReelHead from './ReelHead.astro';
import Icon from './Icon.astro';
import { loadPhotos } from '../lib/photos';
import { music } from '../lib/music';
import { pad, safeJson } from '../lib/util';

const photos = await loadPhotos();
const total = photos.length;
const settings = (p: (typeof photos)[number]) => [p.focal, p.aperture, p.shutter, p.iso].filter(Boolean).join(' · ');
const data = photos.map((p) => ({
  title: p.title,
  place: p.place,
  date: p.date,
  alt: p.alt,
  src: p.full.src,
  srcset: p.full.srcset,
  w: p.width,
  h: p.height,
  tone: p.tone,
  camera: p.camera,
  lens: p.lens,
  focal: p.focal,
  aperture: p.aperture,
  shutter: p.shutter,
  iso: p.iso,
}));
---

<section id="darkroom" class="reel darkroom" data-scene="darkroom" aria-labelledby="darkroom-title">
  <ReelHead
    id="darkroom-title"
    number={music ? '04' : '03'}
    title="The darkroom"
    kicker="Photographs"
    accent="red"
    symbol="●"
    variant="safelight"
    speed={46}
  >
    <p slot="aside" class="eyebrow safelight"><span class="safelight__bulb"></span>Safelight on</p>
  </ReelHead>

  {
    total === 0 ? (
      <div class="wrap">
        <p class="lede">
          The darkroom is empty. Drop JPEGs into <code>src/photos</code> and they will develop here.
        </p>
      </div>
    ) : (
      <Fragment>
        <div class="wrap darkroom__intro">
          <p class="lede reveal">
            Frames I keep coming back to. They develop as you scroll; tap one to look through the viewfinder.
          </p>
          <div class="darkroom__tools reveal">
            <div class="layout-toggle" role="group" aria-label="Layout">
              <button type="button" data-layout-btn="strip" aria-pressed="true">
                Strip
              </button>
              <button type="button" data-layout-btn="sheet" aria-pressed="false">
                Contact sheet
              </button>
            </div>
            <p class="darkroom__count">{pad(total)} frames</p>
          </div>
        </div>

        <div class="roll" data-roll data-layout="strip">
          <ol class="roll__frames">
            {photos.map((photo, i) => (
              <li class="frame" style={`--ratio:${photo.ratio.toFixed(4)};--tone:${photo.tone}`}>
                <figure>
                  <button
                    type="button"
                    class="frame__btn"
                    data-open={i}
                    aria-label={`Open “${photo.title}” in the viewfinder, frame ${i + 1} of ${total}`}
                  >
                    <img
                      src={photo.thumb.src}
                      srcset={photo.thumb.srcset}
                      sizes="(min-width: 64rem) 52vw, 82vw"
                      width={photo.width}
                      height={photo.height}
                      alt={photo.alt}
                      loading={i < 1 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </button>
                  <figcaption class="frame__cap">
                    <span class="frame__no" aria-hidden="true">
                      {pad(i + 1)}
                      <i>▸</i>
                      {pad(i + 1)}A
                    </span>
                    <span class="frame__title">{photo.title}</span>
                    <span class="frame__meta">
                      {[photo.place, photo.date].filter(Boolean).join(' · ')}
                    </span>
                    {settings(photo) && <span class="frame__exif">{settings(photo)}</span>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ol>
        </div>

        <div class="wrap roll-nav" aria-hidden="true">
          <button type="button" class="roll-nav__btn" data-roll-step="-1" tabindex="-1">
            <Icon name="left" size={18} />
          </button>
          <button type="button" class="roll-nav__btn" data-roll-step="1" tabindex="-1">
            <Icon name="right" size={18} />
          </button>
        </div>

        <dialog class="viewfinder" data-viewfinder aria-label="Photo viewer">
          <div class="vf">
            <div class="vf__top">
              <span class="vf__count" data-vf-count>
                01 / {pad(total)}
              </span>
              <span class="vf__mode" aria-hidden="true">
                <i />
                AF-S · RAW
              </span>
              <button type="button" class="vf__close" data-vf-close aria-label="Close the viewer">
                <Icon name="close" size={20} />
              </button>
            </div>

            <div class="vf__stage" data-vf-stage>
              <div class="vf__frame" data-vf-frame>
                <img data-vf-img alt="" />
                <span class="vf__corners" aria-hidden="true" />
                <span class="vf__focus" aria-hidden="true" />
              </div>
              <button type="button" class="vf__nav vf__nav--prev" data-vf-prev aria-label="Previous photo">
                <Icon name="left" size={20} />
              </button>
              <button type="button" class="vf__nav vf__nav--next" data-vf-next aria-label="Next photo">
                <Icon name="right" size={20} />
              </button>
            </div>

            <div class="vf__bottom">
              <p class="vf__lcd" data-vf-lcd aria-hidden="true" />
              <p class="vf__meter" aria-hidden="true">
                <span>-2</span>
                <span>·</span>
                <span>1</span>
                <span>·</span>
                <span class="vf__zero">0</span>
                <span>·</span>
                <span>1</span>
                <span>·</span>
                <span>+2</span>
              </p>
              <p class="vf__caption">
                <strong data-vf-title /> <span data-vf-meta />
              </p>
              <p class="vf__gear" data-vf-gear />
            </div>
          </div>
        </dialog>

        <script type="application/json" id="photo-data" is:inline set:html={safeJson(data)} />
      </Fragment>
    )
  }
</section>

<style>
  .safelight {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ff9c86;
  }

  .safelight__bulb {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 10px 2px rgb(255 70 40 / 0.7);
    animation: glow 3.2s ease-in-out infinite;
  }

  @keyframes glow {
    50% {
      box-shadow: 0 0 16px 5px rgb(255 70 40 / 0.45);
    }
  }

  .lede {
    max-width: 38ch;
    font-size: clamp(1.2rem, 4.6vw, 1.7rem);
    font-weight: 450;
    line-height: 1.35;
    color: #f0d9d0;
    text-wrap: pretty;
  }

  .darkroom__intro {
    display: grid;
    gap: 1.5rem;
  }

  .darkroom__tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .layout-toggle {
    display: inline-flex;
    padding: 4px;
    border: 1px solid rgb(255 90 60 / 0.3);
    border-radius: 999px;
    background: rgb(29 7 5 / 0.6);
  }

  .layout-toggle button {
    min-height: 38px;
    padding: 0 0.95rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d9aaa0;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .layout-toggle button[aria-pressed='true'] {
    background: var(--red);
    color: #1a0503;
    font-weight: 700;
  }

  .darkroom__count {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c98b7d;
  }

  /* ---------- the roll: a vertical strip on phones ---------- */

  .roll {
    --holes-v: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='26'><rect x='1.5' y='6' width='9' height='14' rx='2.2' fill='%23ff4a2a' fill-opacity='.5'/></svg>");
    --holes-h: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='26' height='12'><rect x='6' y='1.5' width='14' height='9' rx='2.2' fill='%23ff4a2a' fill-opacity='.5'/></svg>");
    position: relative;
    margin: 2rem auto 0;
    width: min(100%, 44rem);
    background: linear-gradient(90deg, #170605, #1f0907 50%, #170605);
    border-block: 1px solid rgb(255 90 60 / 0.18);
  }

  .roll::before,
  .roll::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12px;
    background: var(--holes-v) 0 0 / 12px 26px repeat-y;
  }

  .roll::before {
    left: 7px;
  }

  .roll::after {
    right: 7px;
  }

  .roll__frames {
    display: grid;
    gap: 2.4rem;
    padding: 1.6rem 2rem 2rem;
  }

  .frame figure {
    display: grid;
    gap: 0.75rem;
  }

  .frame__btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: 2px;
    background: var(--tone);
    cursor: zoom-in;
  }

  .frame__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      filter 2.8s cubic-bezier(0.55, 0, 0.25, 1),
      transform 0.6s var(--ease-out);
  }

  .frame__btn:hover img {
    transform: scale(1.02);
  }

  /* undeveloped: a pale sheet under red light */
  .frame__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(255 50 25 / 0.42);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 3.2s cubic-bezier(0.55, 0, 0.25, 1);
    pointer-events: none;
  }

  :global(.js) .frame:not(.is-developed) img {
    filter: grayscale(1) brightness(2.3) contrast(0.22);
  }

  :global(.js) .frame:not(.is-developed) .frame__btn::after {
    opacity: 1;
  }

  .frame__cap {
    display: grid;
    gap: 0.15rem;
  }

  .frame__no {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: #ff8a6a;
  }

  .frame__no i {
    margin-inline: 0.35em;
    font-style: normal;
  }

  .frame__title {
    font-family: var(--f-serif);
    font-size: 1.55rem;
    font-style: italic;
    line-height: 1.1;
  }

  .frame__meta {
    font-size: 0.92rem;
    color: #c9a69c;
  }

  .frame__exif {
    margin-top: 0.2rem;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: #b98a7f;
  }

  /* ---------- contact sheet ---------- */

  .roll[data-layout='sheet'] {
    width: min(100% - 2 * var(--gutter), var(--max));
    border: 1px solid rgb(255 90 60 / 0.18);
    border-radius: 6px;
  }

  .roll[data-layout='sheet']::before,
  .roll[data-layout='sheet']::after {
    display: none;
  }

  .roll[data-layout='sheet'] .roll__frames {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 6px;
    padding: 0.9rem;
  }

  .roll[data-layout='sheet'] .frame__btn {
    aspect-ratio: 1;
  }

  .roll[data-layout='sheet'] .frame__cap > :not(.frame__no) {
    display: none;
  }

  .roll[data-layout='sheet'] .frame figure {
    gap: 0.35rem;
  }

  .roll-nav {
    display: none;
  }

  .roll-nav__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 90 60 / 0.35);
    border-radius: 50%;
    background: rgb(29 7 5 / 0.8);
    color: #ffd9cf;
    transition: border-color 0.2s;
  }

  .roll-nav__btn:hover {
    border-color: #ffd9cf;
  }

  /* ---------- the viewfinder ---------- */

  .viewfinder {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #050505;
    color: #eef3e8;
    overflow: hidden;
  }

  .viewfinder[open] {
    animation: vf-in 0.35s var(--ease-out);
  }

  @keyframes vf-in {
    from {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  .viewfinder::backdrop {
    background: #000;
  }

  .vf {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
  }

  .vf__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem var(--gutter);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: #b6f5c2;
  }

  .vf__mode {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .vf__mode i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--red);
    animation: glow 2s ease-in-out infinite;
  }

  .vf__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: #eef3e8;
  }

  .vf__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0.75rem var(--gutter);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .vf__frame {
    position: relative;
    display: grid;
    max-width: 100%;
    max-height: 100%;
    transition:
      transform 0.35s var(--ease-out),
      opacity 0.35s;
  }

  .vf__frame.is-dragging {
    transition: none;
  }

  .vf__frame img {
    max-width: 100%;
    max-height: calc(100dvh - 15rem);
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--vf-tone, #111);
    transition: opacity 0.3s;
  }

  .vf__frame img.is-loading {
    opacity: 0.25;
  }

  .vf__corners {
    position: absolute;
    inset: -10px;
    pointer-events: none;
    opacity: 0.85;
    background:
      linear-gradient(#eef3e8, #eef3e8) top left / 24px 2px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) top left / 2px 24px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) top right / 24px 2px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) top right / 2px 24px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) bottom left / 24px 2px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) bottom left / 2px 24px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) bottom right / 24px 2px no-repeat,
      linear-gradient(#eef3e8, #eef3e8) bottom right / 2px 24px no-repeat;
  }

  .vf__focus {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(16%, 5rem);
    aspect-ratio: 1;
    border: 1.5px solid rgb(182 245 194 / 0.85);
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: focus 0.6s var(--ease-out);
  }

  @keyframes focus {
    from {
      transform: translate(-50%, -50%) scale(1.5);
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
  }

  .vf__nav {
    position: absolute;
    top: 50%;
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(238 243 232 / 0.25);
    border-radius: 50%;
    background: rgb(5 5 5 / 0.6);
    color: #eef3e8;
    transform: translateY(-50%);
  }

  .vf__nav--prev {
    left: 1rem;
  }

  .vf__nav--next {
    right: 1rem;
  }

  .vf__bottom {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 0.5rem var(--gutter) 1.1rem;
    text-align: center;
  }

  .vf__lcd {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.2rem;
    font-family: var(--f-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #b6f5c2;
    text-shadow: 0 0 8px rgb(120 255 150 / 0.35);
  }

  .vf__meter {
    display: flex;
    gap: 0.55rem;
    font-family: var(--f-mono);
    font-size: 0.6rem;
    color: rgb(182 245 194 / 0.6);
  }

  .vf__zero {
    position: relative;
    color: #b6f5c2;
  }

  .vf__zero::after {
    content: '▲';
    position: absolute;
    top: 100%;
    left: 50%;
    font-size: 0.5rem;
    transform: translateX(-50%);
  }

  .vf__caption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: #b9bcb3;
  }

  .vf__caption strong {
    margin-right: 0.35rem;
    font-family: var(--f-serif);
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 400;
    color: #f4f1ea;
  }

  .vf__gear {
    font-family: var(--f-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #868a80;
  }

  /* ---------- wider screens: the strip runs sideways ---------- */

  @media (min-width: 48rem) {
    .roll[data-layout='sheet'] .roll__frames {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem 8px;
      padding: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .roll[data-layout='strip'] {
      width: 100%;
      background: linear-gradient(#170605, #1f0907 50%, #170605);
    }

    .roll[data-layout='strip']::before,
    .roll[data-layout='strip']::after {
      top: auto;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 12px;
      background: var(--holes-h) 0 0 / 26px 12px repeat-x;
    }

    .roll[data-layout='strip']::before {
      top: 8px;
    }

    .roll[data-layout='strip']::after {
      bottom: 8px;
    }

    .roll[data-layout='strip'] .roll__frames {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      padding: 2.75rem max(var(--gutter), calc((100vw - var(--max)) / 2)) 2.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      scrollbar-color: rgb(255 90 60 / 0.5) transparent;
    }

    .roll[data-layout='strip'] .frame {
      flex: none;
      scroll-snap-align: center;
    }

    .roll[data-layout='strip'] .frame__btn {
      width: auto;
      height: min(62svh, 34rem);
    }

    .roll[data-layout='strip'] .frame__cap {
      max-width: calc(min(62svh, 34rem) * var(--ratio));
    }

    .vf__nav {
      display: grid;
    }

    .vf__frame img {
      max-height: calc(100dvh - 13rem);
    }
  }

  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    .roll[data-layout='strip'] + .roll-nav {
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
      margin-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .safelight__bulb,
    .vf__mode i,
    .vf__focus,
    .viewfinder[open] {
      animation: none;
    }

    .frame__btn img,
    .frame__btn::after {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/darkroom';
</script>
