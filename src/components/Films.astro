---
import ReelHead from './ReelHead.astro';
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import { site } from '../site.config';
import {
  diary,
  entries,
  filmUrl,
  histogram,
  histogramPeak,
  lists,
  oneLiners,
  pick,
  poster,
  stats,
  verdict,
} from '../lib/films';
import { dayMonthYear, longDate, pad, ratingLabel, shortDate } from '../lib/util';
import { starsInSvg, starsMarkup } from '../lib/stars';

const handle = diary.username || site.letterboxd;
const profile = diary.profile;
const pickPoster = pick ? poster(pick.poster) : null;
/* Each rating gets its own colour: red at ½★, through amber, to green at 5★. */
function ratingTone(rating: number) {
  const t = (rating - 0.5) / 4.5;
  return t <= 0.5
    ? `color-mix(in oklch, var(--amber) ${Math.round(t * 200)}%, var(--red))`
    : `color-mix(in oklch, var(--green) ${Math.round((t - 0.5) * 200)}%, var(--amber))`;
}

const rows = oneLiners.length >= 8 ? [oneLiners.filter((_, i) => i % 2 === 0), oneLiners.filter((_, i) => i % 2 === 1)] : [oneLiners];

/* festival laurels around "PJ's pick", drawn from a circle */
function laurel(mirror: boolean) {
  const cx = 100;
  const cy = 64;
  const r = 50;
  const leaves: string[] = [];
  for (let i = 0; i < 9; i++) {
    const theta = ((112 + i * 15.5) * Math.PI) / 180;
    const x = cx + r * Math.cos(theta);
    const y = cy + r * Math.sin(theta);
    const along = (theta * 180) / Math.PI + 90;
    for (const tilt of [-28, 28]) {
      const offset = tilt < 0 ? -3.2 : 3.2;
      const lx = x + offset * Math.cos(theta);
      const ly = y + offset * Math.sin(theta);
      const angle = along + tilt;
      const px = mirror ? 2 * cx - lx : lx;
      const deg = mirror ? 180 - angle : angle;
      leaves.push(
        `<ellipse cx="${px.toFixed(1)}" cy="${ly.toFixed(1)}" rx="8.2" ry="3.1" transform="rotate(${deg.toFixed(1)} ${px.toFixed(1)} ${ly.toFixed(1)})"/>`,
      );
    }
  }
  const a0 = (112 * Math.PI) / 180;
  const a1 = ((112 + 8 * 15.5) * Math.PI) / 180;
  const sx = cx + r * Math.cos(a0);
  const ex = cx + r * Math.cos(a1);
  const stem = mirror
    ? `<path d="M${(2 * cx - sx).toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)} A${r} ${r} 0 0 0 ${(2 * cx - ex).toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}" fill="none" stroke="currentColor" stroke-width="1.6"/>`
    : `<path d="M${sx.toFixed(1)} ${(cy + r * Math.sin(a0)).toFixed(1)} A${r} ${r} 0 0 1 ${ex.toFixed(1)} ${(cy + r * Math.sin(a1)).toFixed(1)}" fill="none" stroke="currentColor" stroke-width="1.6"/>`;
  return stem + leaves.join('');
}
const laurels = laurel(false) + laurel(true);
---

<section id="films" class="reel films" data-scene="films" aria-labelledby="films-title">
  <ReelHead
    id="films-title"
    number="02"
    title="The film diary"
    kicker="Letterboxd"
    accent="amber"
    symbol="★"
    variant="sign"
    dir="rtl"
    speed={48}
  >
    <a slot="aside" class="eyebrow films__handle" href={profile} target="_blank" rel="noopener noreferrer">
      @{handle} ↗
    </a>
  </ReelHead>

  {
    entries.length === 0 ? (
      <div class="wrap films__empty">
        <p class="lede">The projector is warming up. Until the diary syncs, the reviews live on Letterboxd.</p>
        <a class="pill pill--solid accent-amber" href={profile} target="_blank" rel="noopener noreferrer">
          Open the diary <Icon name="arrow" />
        </a>
      </div>
    ) : (
      <Fragment>
        <div class="wrap films__intro">
          <p class="lede reveal">
            Every film I watch gets logged, rated out of five and, more often than not, summed up in a sentence.
            Here's the latest from the diary.
          </p>
        </div>

        {/* ---- box office ---- */}
        <div class="wrap boxoffice reveal">
          <dl class="tally">
            <div>
              <dt>Films logged</dt>
              <dd>{stats.logged}</dd>
            </div>
            <div>
              <dt>Reviews</dt>
              <dd>{stats.reviews}</dd>
            </div>
            <div>
              <dt>Hearts</dt>
              <dd>{stats.liked}</dd>
            </div>
            <div>
              <dt>Rewatches</dt>
              <dd>{stats.rewatches}</dd>
            </div>
          </dl>

          {stats.average != null && (
            <div class="ratings">
              <p class="ratings__avg">
                <span class="ratings__num">{stats.average.toFixed(1)}</span>
                <span class="ratings__label">
                  average rating
                  <br />
                  <em>{verdict(stats.average)}</em>
                </span>
              </p>
              <div class="histogram" role="group" aria-label="Filter the diary by rating">
                {histogram.map((bucket) => (
                  <button
                    type="button"
                    class="bar"
                    data-rating={bucket.rating}
                    aria-pressed="false"
                    aria-label={`${bucket.count} ${bucket.count === 1 ? 'film' : 'films'} rated ${bucket.rating} out of 5`}
                    style={`--h:${Math.max(0.04, bucket.count / histogramPeak)};--tone:${ratingTone(bucket.rating)}`}
                    disabled={bucket.count === 0}
                  >
                    <span class="bar__count">{bucket.count}</span>
                    <span class="bar__fill" />
                  </button>
                ))}
              </div>
              <div class="histogram__axis" aria-hidden="true">
                <span style={`color:${ratingTone(0.5)}`} set:html={starsMarkup(0.5)} />
                <span class="histogram__hint">tap a bar to filter</span>
                <span style={`color:${ratingTone(5)}`} set:html={starsMarkup(5)} />
              </div>
            </div>
          )}

          {stats.since && (
            <p class="boxoffice__note">
              Counting the last {stats.logged} diary entries, back to {dayMonthYear(stats.since)}.
            </p>
          )}
        </div>

        {/* ---- the diary strip ---- */}
        <div class="diary-block">
          <div class="wrap diary-block__head">
            <h3 class="sub reveal">Latest screenings</h3>
            <div class="diary-block__tools">
              <p class="diary-block__status" aria-live="polite" data-diary-status>
                {entries.length} films, newest first
              </p>
              <div class="diary-block__actions">
                <button type="button" class="diary-block__clear" data-diary-clear hidden>
                  Show all
                </button>
                <button type="button" class="pill diary-block__auto" data-diary-auto hidden>
                  <span data-auto-icon="pause"><Icon name="pause" size={14} /></span>
                  <span data-auto-icon="play" hidden><Icon name="play" size={14} /></span>
                  <span data-auto-label>Pause</span>
                  <span class="sr-only">sliding</span>
                </button>
              </div>
            </div>
          </div>

          <div class="diary-scroller">
            <ol class="diary" data-diary>
              {entries.map((entry, i) => {
                const art = poster(entry.poster);
                return (
                  <li class="stub" data-rating={entry.rating ?? ''}>
                    <button type="button" class="stub__btn" data-entry={entry.id} aria-haspopup="dialog">
                      <span class="stub__poster" aria-hidden="true">
                        {art ? (
                          <img
                            src={art.src}
                            srcset={art.srcset}
                            sizes="(min-width: 48rem) 190px, 40vw"
                            width="300"
                            height="450"
                            alt=""
                            loading={i < 4 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                        ) : (
                          <span class="stub__blank">{entry.title}</span>
                        )}
                        <span class="stub__flags">
                          {entry.review.length > 0 && <span class="stub__flag stub__flag--review">“</span>}
                          {entry.liked && (
                            <span class="stub__flag stub__flag--liked">
                              <Icon name="heart" stroke={2.2} />
                            </span>
                          )}
                          {entry.rewatch && (
                            <span class="stub__flag">
                              <Icon name="rewatch" stroke={2.2} />
                            </span>
                          )}
                        </span>
                      </span>
                      <span class="stub__ticket" aria-hidden="true">
                        <span class="stub__title">{entry.title}</span>
                        <span class="stub__meta">
                          <span>{shortDate(entry.watched)}</span>
                          {entry.rating != null ? (
                            <span class="stub__stars" set:html={starsMarkup(entry.rating)} />
                          ) : (
                            <span class="stub__stars">—</span>
                          )}
                        </span>
                      </span>
                      <span class="sr-only">
                        {entry.title}
                        {entry.year ? ` (${entry.year})` : ''}. {ratingLabel(entry.rating)}. Watched{' '}
                        {longDate(entry.watched)}.{entry.liked ? ' Liked.' : ''}
                        {entry.rewatch ? ' Rewatch.' : ''}
                        {entry.review.length ? ' Has a review.' : ''}
                      </span>
                    </button>
                  </li>
                );
              })}
            </ol>
          </div>

          <div class="wrap diary-block__nav" aria-hidden="true">
            <button type="button" class="round" data-diary-prev tabindex="-1">
              <Icon name="left" size={18} />
            </button>
            <button type="button" class="round" data-diary-next tabindex="-1">
              <Icon name="right" size={18} />
            </button>
          </div>
        </div>

        {entries.map((entry) => {
          const art = poster(entry.poster);
          return (
            <template id={`entry-${entry.id}`}>
              <article class="entry">
                {art && (
                  <img
                    class="entry__poster"
                    src={art.src}
                    srcset={art.srcset}
                    sizes="(min-width: 48rem) 200px, 36vw"
                    width="300"
                    height="450"
                    alt={`Poster for ${entry.title}`}
                  />
                )}
                <header class="entry__head">
                  <p class="entry__when">
                    {entry.kind === 'review' ? 'Review' : 'Diary entry'} · {longDate(entry.watched)}
                  </p>
                  <h3 class="entry__title" id="sheet-title">
                    {entry.title} {entry.year && <span>{entry.year}</span>}
                  </h3>
                  <p class="entry__badges">
                    <Stars rating={entry.rating} class="entry__stars" />
                    {entry.liked && (
                      <span class="entry__badge entry__badge--liked">
                        <Icon name="heart" stroke={2.2} /> Liked
                      </span>
                    )}
                    {entry.rewatch && (
                      <span class="entry__badge">
                        <Icon name="rewatch" stroke={2.2} /> Rewatch
                      </span>
                    )}
                  </p>
                </header>
                <div class="entry__review">
                  {entry.spoilers && <p class="entry__spoiler">Contains spoilers.</p>}
                  {entry.review.length ? (
                    entry.review.map((paragraph) => <p>{paragraph}</p>)
                  ) : (
                    <p class="entry__none">No review, just the stars.</p>
                  )}
                </div>
                <footer class="entry__links">
                  <a class="pill pill--solid accent-amber" href={entry.url} target="_blank" rel="noopener noreferrer">
                    On Letterboxd <Icon name="arrow" />
                  </a>
                  <a class="pill" href={filmUrl(entry)} target="_blank" rel="noopener noreferrer">
                    Film page <Icon name="arrow" />
                  </a>
                </footer>
              </article>
            </template>
          );
        })}

        {/* ---- one-liners ---- */}
        {oneLiners.length > 0 && (
          <div class="quotes" data-quotes>
            <div class="wrap quotes__head">
              <h3 class="sub reveal">The one-liners</h3>
              <button type="button" class="pill quotes__toggle" data-quotes-toggle aria-pressed="false">
                <span data-quotes-icon="pause"><Icon name="pause" size={14} /></span>
                <span data-quotes-icon="play" hidden><Icon name="play" size={14} /></span>
                <span data-quotes-label>Pause</span>
              </button>
            </div>
            <ul class="sr-only">
              {oneLiners.map(({ quote, entry }) => (
                <li>
                  “{quote}”, on {entry.title}. {ratingLabel(entry.rating)}.
                </li>
              ))}
            </ul>
            {rows.map((row, r) => (
              <div class="quotes__row" data-dir={r % 2 ? 'rtl' : 'ltr'} style={`--speed:${54 + r * 12}s`} aria-hidden="true">
                <div class="quotes__track">
                  {[...row, ...row].map(({ quote, entry }) => (
                    <span class="quote">
                      <span class="quote__text">“{quote}”</span>
                      <span class="quote__meta">
                        <span class="quote__stars" set:html={starsMarkup(entry.rating)} />
                        {entry.title}
                      </span>
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ---- critic's pick ---- */}
        {pick && (
          <article class="wrap pick" aria-labelledby="pick-title">
            <div class="pick__poster reveal">
              {pickPoster && (
                <img
                  src={pickPoster.src}
                  srcset={pickPoster.srcset}
                  sizes="(min-width: 64rem) 380px, (min-width: 48rem) 40vw, 76vw"
                  width="300"
                  height="450"
                  alt={`Poster for ${pick.title}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <svg class="laurels" viewBox="0 0 200 128" aria-hidden="true" focusable="false">
                <g fill="currentColor" set:html={laurels} />
                <text x="100" y="52" text-anchor="middle" class="laurels__small">
                  PJ's pick
                </text>
                {pick.rating != null && <g fill="currentColor" set:html={starsInSvg(pick.rating, 100, 64.5, 13.5, 1.6)} />}
                <text x="100" y="96" text-anchor="middle" class="laurels__small">
                  {pick.watched.slice(0, 4)}
                </text>
              </svg>
            </div>
            <div class="pick__copy">
              <p class="eyebrow reveal">Critic's pick · watched {longDate(pick.watched)}</p>
              <h3 id="pick-title" class="pick__title reveal">
                {pick.title} {pick.year && <span>({pick.year})</span>}
              </h3>
              <blockquote class="pick__quote reveal" cite={pick.url}>
                {pick.review.map((paragraph, i) => (
                  <p class:list={[i === 0 && 'pick__lead']}>{i === 0 ? `“${paragraph}”` : paragraph}</p>
                ))}
              </blockquote>
              <p class="pick__sign reveal">
                <Stars rating={pick.rating} /> <span>— {site.nickname}</span>
              </p>
              <a class="pill reveal" href={pick.url} target="_blank" rel="noopener noreferrer">
                Read it on Letterboxd <Icon name="arrow" />
              </a>
            </div>
          </article>
        )}

        {/* ---- lists as cinema programmes ---- */}
        {lists.length > 0 && (
          <div class="programmes">
            <div class="wrap">
              <h3 class="sub reveal">
                Programmes <span>{diary.lists.length} lists</span>
              </h3>
            </div>
            <ol class="programmes__list">
              {lists.map((list, i) => (
                <li class="programme reveal" style={`--delay:${(i % 3) * 0.08}s`}>
                  <a href={list.url} target="_blank" rel="noopener noreferrer">
                    <p class="programme__no">
                      Programme {pad(i + 1)} · {list.total} {list.total === 1 ? 'film' : 'films'}
                      {list.ranked ? ' · ranked' : ''}
                    </p>
                    <h4 class="programme__title">{list.title}</h4>
                    {list.description && <p class="programme__desc">{list.description}</p>}
                    <ol class:list={['programme__films', list.ranked && 'is-ranked']}>
                      {list.films.slice(0, 5).map((film, k) => (
                        <li>
                          <span class="programme__n">{list.ranked ? pad(k + 1) : '·'}</span>
                          <span class="programme__film">{film.title}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="programme__more">
                      {list.total > 5 ? `+ ${list.total - 5} more` : 'See the list'} <Icon name="arrow" />
                    </p>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div class="wrap films__cta reveal">
          <a class="pill pill--solid accent-amber" href={profile} target="_blank" rel="noopener noreferrer">
            Follow @{handle} on Letterboxd <Icon name="arrow" />
          </a>
        </div>

        <dialog class="sheet" data-sheet aria-labelledby="sheet-title">
          <div class="sheet__grip" aria-hidden="true" />
          <button type="button" class="sheet__close round" data-sheet-close aria-label="Close">
            <Icon name="close" size={18} />
          </button>
          <div class="sheet__body" data-sheet-body />
        </dialog>
      </Fragment>
    )
  }
</section>

<style>
  .lede {
    max-width: 38ch;
    font-size: clamp(1.2rem, 4.6vw, 1.7rem);
    font-weight: 450;
    line-height: 1.35;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  .films__handle {
    color: var(--amber);
    text-decoration: none;
  }

  .films__empty {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 10vw, 4rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .sub span {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .round {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: rgb(22 20 15 / 0.8);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .round:hover {
    border-color: var(--paper);
  }

  /* ---------- box office ---------- */

  .boxoffice {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.5rem;
    padding: 1.25rem;
    border: 1px solid rgb(255 182 39 / 0.18);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 182 39 / 0.07), transparent 60%),
      var(--ink-2);
  }

  .tally {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .tally div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.4rem;
  }

  .tally dt {
    font-family: var(--f-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tally dd {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 11vw, 4rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.85;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }

  .ratings {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line-2);
  }

  .ratings__avg {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .ratings__num {
    font-family: var(--f-display);
    font-size: 3.6rem;
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.8;
  }

  .ratings__label {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ratings__label em {
    font-family: var(--f-serif);
    font-size: 1.45rem;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    color: var(--paper);
  }

  .histogram {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    align-items: end;
    gap: 4px;
    height: 7rem;
  }

  .bar {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    height: 100%;
    min-height: 44px;
    padding: 0;
  }

  .bar__fill {
    width: 100%;
    height: calc(var(--h) * (100% - 1.2rem));
    min-height: 3px;
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(var(--tone, var(--amber)), color-mix(in oklch, var(--tone, var(--amber)) 80%, transparent));
    transition:
      background 0.25s,
      opacity 0.25s,
      transform 0.25s var(--ease-spring);
    transform-origin: bottom;
  }

  .bar__count {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    color: var(--muted);
    transition: color 0.25s;
  }

  .bar:disabled {
    cursor: default;
  }

  .bar:disabled .bar__fill {
    background: var(--ink-4);
  }

  .bar:disabled .bar__count {
    opacity: 0.4;
  }

  .histogram:has(.bar[aria-pressed='true']) .bar:not([aria-pressed='true']) .bar__fill {
    opacity: 0.3;
  }

  .bar[aria-pressed='true'] .bar__fill {
    background: linear-gradient(var(--paper), var(--tone, var(--amber)));
  }

  .bar[aria-pressed='true'] .bar__count {
    color: var(--tone, var(--paper));
  }

  .bar:not(:disabled):hover .bar__fill {
    transform: scaleY(1.04);
  }

  .histogram__axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--amber);
    font-size: 0.8rem;
  }

  .histogram__hint {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .boxoffice__note {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--dim);
  }

  /* ---------- diary strip ---------- */

  .diary-block {
    margin-top: clamp(3.5rem, 10vw, 6rem);
  }

  .diary-block__head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .diary-block__tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.25rem;
  }

  .diary-block__status {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .diary-block__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .diary-block__auto {
    min-height: 36px;
    padding-inline: 0.85rem;
  }

  .diary-block__auto [data-auto-icon] {
    display: inline-flex;
  }

  .diary-block__auto [hidden] {
    display: none;
  }

  .diary-block__clear {
    padding: 0.5rem 0.9rem;
