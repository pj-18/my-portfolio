---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import Ticket from './Ticket.astro';
import { site } from '../site.config';
import { latest, poster } from '../lib/films';
import { shortDate } from '../lib/util';
import type { IconName } from '../lib/icons';

const lines: { word: string; rest: string; accent: string; icons: IconName[] }[] = [
  { word: 'code', rest: 'by day.', accent: 'green', icons: ['code', 'check', 'terminal'] },
  { word: 'cinema', rest: 'by night.', accent: 'amber', icons: ['clapper', 'reel', 'popcorn'] },
  { word: 'frames', rest: 'in between.', accent: 'red', icons: ['camera', 'aperture', 'frame'] },
];

const latestPoster = latest ? poster(latest.poster) : null;
---

<section id="top" class="hero" data-scene="top" aria-labelledby="hero-title">
  <div class="hero__beam" aria-hidden="true"></div>
  <Ticket />

  <div class="hero__inner wrap">
    <p class="hero__kicker eyebrow">{site.name}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">{site.name}, {site.nickname} for short: code by day, cinema by night, frames in between.</span>
      {
        lines.map((line, i) => (
          <span class="hero__line" style={`--i:${i}`} aria-hidden="true">
            <span class={`hero__word accent-${line.accent}`}>{line.word}</span>{' '}
            <span class={`slot accent-${line.accent}`} style={`--o:${i}`}>
              <span class="slot__paren">(</span>
              <span class="slot__icons">
                {line.icons.map((name) => (
                  <Icon name={name} stroke={2} />
                ))}
              </span>
              <span class="slot__paren">)</span>
            </span>{' '}
            <span class="hero__rest">{line.rest}</span>
          </span>
        ))
      }
    </h1>

    <div class="hero__foot">
      <p class="hero__intro">
        I'm <strong>{site.name}</strong>, {site.nickname} for short: a senior software engineer who ships web apps and
        the tests that keep them honest. Grab a seat, the feature is about to start.
      </p>

      {
        latest && (
          <a class="now" href={latest.url} target="_blank" rel="noopener noreferrer">
            {latestPoster && (
              <img
                class="now__poster"
                src={latestPoster.src}
                srcset={latestPoster.srcset}
                sizes="44px"
                width="44"
                height="66"
                alt=""
                decoding="async"
              />
            )}
            <span class="now__text">
              <span class="now__label">
                <span class="now__dot" />
                Last watched · {shortDate(latest.watched)}
              </span>
              <span class="now__title">
                {latest.title} {latest.year && <span>({latest.year})</span>}
              </span>
            </span>
            <Stars rating={latest.rating} class="now__stars" />
          </a>
        )
      }

      <a class="hero__cue" href="#films">
        <span>Roll the feature</span>
        <Icon name="down" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Phones: anchor to the top so the space beside the ticket is used on tall
       screens too; any slack falls to the bottom, behind the floating nav. */
    justify-content: flex-start;
    min-height: 100svh;
    /* The ticket hangs top-right. Let the kicker and the first two (short) title
       rows sit beside it, and only push far enough that row three ("cinema ( )",
       the widest) clears the ticket's bottom edge. 1.72 = two rows at
       line-height 0.86 of the title's own font-size clamp. */
    padding-top: max(10rem, calc(16rem - 1.72 * clamp(3.4rem, 16.2vw, 6.4rem)));
    padding-bottom: 1.25rem;
    overflow: clip;
    isolation: isolate;
  }

  .hero__beam {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      conic-gradient(
        from 196deg at 82% -6%,
        transparent 0deg,
        rgb(255 226 170 / 0.07) 8deg,
        rgb(255 226 170 / 0.12) 15deg,
        rgb(255 226 170 / 0.06) 24deg,
        transparent 34deg
      );
    animation: beam 6s ease-in-out infinite alternate;
  }

  @keyframes beam {
    0% {
      opacity: 0.7;
    }
    45% {
      opacity: 1;
    }
    50% {
      opacity: 0.82;
    }
    100% {
      opacity: 0.95;
    }
  }

  .hero__inner {
    position: relative;
  }

  .hero__kicker {
    margin-bottom: 1.1rem;
  }

  .hero__kicker span {
    color: var(--dim);
  }

  .hero__title {
    font-family: var(--f-display);
    font-size: clamp(3.4rem, 16.2vw, 6.4rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.86;
    letter-spacing: -0.012em;
  }

  .hero__line {
    display: block;
    animation: rise 1.05s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i) * 0.11s);
  }

  :global(.intro) .hero__line,
  :global(.intro) .hero__foot {
    animation-play-state: paused;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }

  .hero__word {
    color: var(--accent);
  }

  .hero__rest {
    display: block;
  }

  .slot {
    display: inline-flex;
    align-items: center;
  }

  .slot__paren {
    font-weight: 250;
    color: var(--paper-dim);
    transform: translateY(-0.04em);
  }

  .slot__icons {
    display: inline-grid;
    width: 0.74em;
    height: 0.74em;
    margin-inline: 0.06em;
    color: var(--accent);
  }

  .slot__icons :global(svg) {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: slot-cycle 7.5s var(--ease-out) infinite both;
    animation-delay: calc(var(--o) * 0.7s);
  }

  .slot__icons :global(svg:nth-child(2)) {
    animation-delay: calc(var(--o) * 0.7s + 2.5s);
  }

  .slot__icons :global(svg:nth-child(3)) {
    animation-delay: calc(var(--o) * 0.7s + 5s);
  }

  @keyframes slot-cycle {
    0% {
      opacity: 0;
      transform: translateY(45%) rotate(-14deg) scale(0.6);
    }
    5%,
    30% {
      opacity: 1;
      transform: none;
    }
    35%,
    100% {
      opacity: 0;
      transform: translateY(-45%) rotate(12deg) scale(0.6);
    }
  }

  .hero__foot {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
    animation: rise 1.05s var(--ease-out) 0.45s both;
  }

  .hero__intro {
    max-width: 34ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .hero__intro strong {
    color: var(--paper);
    font-weight: 600;
  }

  .now {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgb(22 20 15 / 0.6);
    text-decoration: none;
    transition: border-color 0.25s;
  }

  .now:hover {
    border-color: rgb(255 182 39 / 0.5);
  }

  .now__poster {
    flex: none;
    width: 44px;
    height: 66px;
    border-radius: 5px;
    object-fit: cover;
    background: var(--ink-3);
  }

  .now__text {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .now__label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--f-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .now__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 0 rgb(255 182 39 / 0.6);
    animation: ping 2s infinite;
  }

  @keyframes ping {
    70% {
      box-shadow: 0 0 0 7px rgb(255 182 39 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(255 182 39 / 0);
    }
  }

  .now__title {
    overflow: hidden;
    font-weight: 600;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .now__title span {
    color: var(--muted);
    font-weight: 400;
  }

  .now :global(.now__stars) {
    margin-left: auto;
    font-size: 0.95rem;
  }

  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding-block: 0.6rem;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .hero__cue :global(svg) {
    animation: nudge 1.8s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* Very narrow phones: even "code ( )" reaches under the ticket. */
  @media (max-width: 22.5rem) {
    .hero {
      padding-top: 16.5rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__title {
      font-size: clamp(4rem, 8.4vw, 9.5rem);
    }

    .hero__rest {
      display: inline;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      justify-content: flex-end;
      padding-bottom: 2.5rem;
    }

    .hero__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1.5rem 3rem;
      margin-top: 2.5rem;
    }

    .hero__intro {
      font-size: 1.15rem;
    }

    .hero__cue {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__beam,
    .hero__line,
    .hero__foot,
    .now__dot,
    .hero__cue :global(svg) {
      animation: none;
    }

    .slot__icons :global(svg) {
      animation: none;
    }

    .slot__icons :global(svg:first-child) {
      opacity: 1;
    }
  }
</style>
