---
import Icon from './Icon.astro';
import Ticket from './Ticket.astro';
import { site } from '../site.config';
import type { IconName } from '../lib/icons';

const lines: { word: string; rest: string; accent: string; icons: IconName[] }[] = [
  { word: 'code', rest: 'by day.', accent: 'green', icons: ['code', 'check', 'terminal'] },
  { word: 'cinema', rest: 'by night.', accent: 'amber', icons: ['clapper', 'reel', 'popcorn'] },
  { word: 'frames', rest: 'in between.', accent: 'red', icons: ['camera', 'aperture', 'frame'] },
];

const [first, ...others] = site.name.toUpperCase().split(' ');
const last = others.join(' ');
---

<section id="top" class="hero" data-scene="top" aria-labelledby="hero-title">
  <div class="hero__backdrop" data-parallax aria-hidden="true">
    <div class="backdrop__screen" data-depth="0.12"></div>
    <div class="backdrop__name" data-depth="0.32">
      <span>{first}</span>
      {last && <span>{last}</span>}
    </div>
    <div class="backdrop__dust" data-depth="0.5"></div>
  </div>
  <div class="hero__beam" aria-hidden="true"></div>
  <Ticket />

  <div class="hero__inner wrap">
    <p class="hero__kicker">{site.name}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">{site.name}, {site.nickname} for short: code by day, cinema by night, frames in between.</span>
      {
        lines.map((line, i) => (
          <span class="hero__line" style={`--i:${i}`} aria-hidden="true">
            <span class={`hero__word accent-${line.accent}`}>{line.word}</span>{' '}
            <span class={`slot accent-${line.accent}`} style={`--o:${i}`}>
              <span class="slot__paren">(</span>
              <span class="slot__icons">
                {line.icons.map((name) => (
                  <Icon name={name} stroke={2} />
                ))}
              </span>
              <span class="slot__paren">)</span>
            </span>{' '}
            <span class="hero__rest">{line.rest}</span>
          </span>
        ))
      }
    </h1>

    <div class="hero__foot">
      <p class="hero__intro">
        I'm <strong>{site.name}</strong>, {site.nickname} for short: a software engineer who ships web apps and
        the tests that keep them honest. Grab a seat, the feature is about to start.
      </p>

      <a class="hero__cue" href="#films">
        <span>Roll the feature</span>
        <Icon name="down" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Phones: anchor to the top so the space beside the ticket is used on tall
       screens too; any slack falls to the bottom, behind the floating nav. */
    justify-content: flex-start;
    min-height: 100svh;
    /* The ticket hangs top-right. Let the kicker and the first two (short) title
       rows sit beside it, and only push far enough that row three ("cinema ( )",
       the widest) clears the ticket's bottom edge. 1.72 = two rows at
       line-height 0.86 of the title's own font-size clamp. */
    padding-top: max(10rem, calc(16rem - 1.72 * clamp(3.4rem, 16.2vw, 6.4rem)));
    padding-bottom: 1.25rem;
    overflow: clip;
    isolation: isolate;
  }

  /* ---------- the backdrop: a dark auditorium with the name across the screen ---------- */

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
    /* melt into the page below instead of ending on a hard edge */
    -webkit-mask-image: linear-gradient(#000 62%, transparent);
    mask-image: linear-gradient(#000 62%, transparent);
  }

  .hero__backdrop > * {
    position: absolute;
    will-change: transform;
  }

  /* screen glow, cool floor light and curtain folds at the edges */
  .backdrop__screen {
    inset: -20% 0;
    background:
      radial-gradient(70% 45% at 60% 30%, rgb(180 210 255 / 0.08), transparent 70%),
      radial-gradient(120% 60% at 50% 100%, rgb(176 38 30 / 0.1), transparent 65%);
  }

  .backdrop__screen::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      rgb(0 0 0 / 0.28) 0 1.1rem,
      rgb(120 24 20 / 0.1) 1.6rem 2.2rem,
      rgb(0 0 0 / 0.28) 2.8rem 3.3rem
    );
    -webkit-mask-image: linear-gradient(90deg, #000, transparent 14%, transparent 86%, #000);
    mask-image: linear-gradient(90deg, #000, transparent 14%, transparent 86%, #000);
  }

  .backdrop__name {
    inset: 14% 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--f-display);
    font-size: 31vw;
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: rgb(243 234 216 / 0.025);
    -webkit-text-stroke: 1.5px rgb(243 234 216 / 0.11);
    -webkit-mask-image: linear-gradient(transparent, #000 18%, #000 72%, transparent);
    mask-image: linear-gradient(transparent, #000 18%, #000 72%, transparent);
  }

  /* specks and a scratch, like an old print */
  .backdrop__dust {
    inset: -10% 0;
    background:
      linear-gradient(90deg, transparent calc(71% - 0.5px), rgb(243 234 216 / 0.06) 71%, transparent calc(71% + 0.5px)),
      radial-gradient(circle at 12% 22%, rgb(210 228 255 / 0.4) 0 1px, transparent 1.6px),
      radial-gradient(circle at 34% 64%, rgb(210 228 255 / 0.3) 0 1.2px, transparent 1.8px),
      radial-gradient(circle at 58% 12%, rgb(210 228 255 / 0.35) 0 1px, transparent 1.6px),
      radial-gradient(circle at 81% 48%, rgb(210 228 255 / 0.3) 0 1.4px, transparent 2px),
      radial-gradient(circle at 90% 78%, rgb(210 228 255 / 0.25) 0 1px, transparent 1.6px),
      radial-gradient(circle at 22% 86%, rgb(210 228 255 / 0.3) 0 1px, transparent 1.6px),
      radial-gradient(circle at 66% 38%, rgb(210 228 255 / 0.22) 0 0.8px, transparent 1.4px);
    animation: flicker 5s steps(1) infinite;
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 0.9;
    }
    23% {
      opacity: 0.55;
    }
    47% {
      opacity: 1;
    }
    71% {
      opacity: 0.7;
    }
  }

  @media (min-width: 48rem) {
    .backdrop__name {
      inset: 9% 0 auto;
      flex-direction: row;
      justify-content: center;
      gap: 0.22em;
      font-size: 15.5vw;
      -webkit-text-stroke-width: 2px;
    }
  }

  .hero__beam {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      conic-gradient(
        from 196deg at 82% -6%,
        transparent 0deg,
        rgb(200 222 255 / 0.07) 8deg,
        rgb(200 222 255 / 0.12) 15deg,
        rgb(200 222 255 / 0.06) 24deg,
        transparent 34deg
      );
    animation: beam 6s ease-in-out infinite alternate;
  }

  @keyframes beam {
    0% {
      opacity: 0.7;
    }
    45% {
      opacity: 1;
    }
    50% {
      opacity: 0.82;
    }
    100% {
      opacity: 0.95;
    }
  }

  .hero__inner {
    position: relative;
  }

  .hero__kicker {
    margin-bottom: 1.1rem;
    font-family: var(--f-mono);
    font-size: clamp(1.05rem, 4.4vw, 1.9rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .hero__title {
    font-family: var(--f-display);
    font-size: clamp(3.4rem, 16.2vw, 6.4rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.86;
    letter-spacing: -0.012em;
  }

  .hero__line {
    display: block;
    animation: rise 1.05s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i) * 0.11s);
  }

  :global(.intro) .hero__line,
  :global(.intro) .hero__foot {
    animation-play-state: paused;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.4em);
    }
  }

  .hero__word {
    color: var(--accent);
  }

  .hero__rest {
    display: block;
  }

  .slot {
    display: inline-flex;
    align-items: center;
  }

  .slot__paren {
    font-weight: 250;
    color: var(--paper-dim);
    transform: translateY(-0.04em);
  }

  .slot__icons {
    display: inline-grid;
    width: 0.74em;
    height: 0.74em;
    margin-inline: 0.06em;
    color: var(--accent);
  }

  .slot__icons :global(svg) {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: slot-cycle 7.5s var(--ease-out) infinite both;
    animation-delay: calc(var(--o) * 0.7s);
  }

  .slot__icons :global(svg:nth-child(2)) {
    animation-delay: calc(var(--o) * 0.7s + 2.5s);
  }

  .slot__icons :global(svg:nth-child(3)) {
    animation-delay: calc(var(--o) * 0.7s + 5s);
  }

  @keyframes slot-cycle {
    0% {
      opacity: 0;
      transform: translateY(45%) rotate(-14deg) scale(0.6);
    }
    5%,
    30% {
      opacity: 1;
      transform: none;
    }
    35%,
    100% {
      opacity: 0;
      transform: translateY(-45%) rotate(12deg) scale(0.6);
    }
  }

  .hero__foot {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
    animation: rise 1.05s var(--ease-out) 0.45s both;
  }

  .hero__intro {
    max-width: 34ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .hero__intro strong {
    color: var(--paper);
    font-weight: 600;
  }

  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding-block: 0.6rem;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .hero__cue :global(svg) {
    animation: nudge 1.8s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  /* Very narrow phones: even "code ( )" reaches under the ticket. */
  @media (max-width: 22.5rem) {
    .hero {
      padding-top: 16.5rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__title {
      font-size: clamp(4rem, 8.4vw, 9.5rem);
    }

    .hero__rest {
      display: inline;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      justify-content: flex-end;
      padding-bottom: 2.5rem;
    }

    .hero__foot {
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .hero__intro {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__beam,
    .backdrop__dust,
    .hero__line,
    .hero__foot,
    .hero__cue :global(svg) {
      animation: none;
    }

    .slot__icons :global(svg) {
      animation: none;
    }

    .slot__icons :global(svg:first-child) {
      opacity: 1;
    }
  }
</style>

<script>
  import '../scripts/parallax';
</script>
