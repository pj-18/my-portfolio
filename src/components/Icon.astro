---
/** One icon from the sprite in Icons.astro. Decorative: pair it with visible or sr-only text. */
interface Props {
  name: 'arrow-down' | 'arrow-up' | 'arrow-out' | 'close' | 'prev' | 'next' | 'first' | 'last' | 'theme';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <use href={`#i-${name}`}></use>
</svg>
