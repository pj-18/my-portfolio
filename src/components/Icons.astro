---
/**
 * The icon sprite, rendered once per page. Icons are drawn on a 24px grid with a
 * 2px square-ended stroke so they sit with the blunt terminals of the typeface.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="i-arrow-down" viewBox="0 0 24 24"><path d="M12 4v15M5.5 12.5 12 19l6.5-6.5"></path></symbol>
    <symbol id="i-arrow-up" viewBox="0 0 24 24"><path d="M12 20V5M5.5 11.5 12 5l6.5 6.5"></path></symbol>
    <symbol id="i-arrow-out" viewBox="0 0 24 24"><path d="M6 18 18 6M8.5 6H18v9.5"></path></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"></path></symbol>
    <symbol id="i-prev" viewBox="0 0 24 24"><path d="m15 4-8 8 8 8"></path></symbol>
    <symbol id="i-next" viewBox="0 0 24 24"><path d="m9 4 8 8-8 8"></path></symbol>
    <symbol id="i-first" viewBox="0 0 24 24"><path d="m18 4-8 8 8 8M6 4v16"></path></symbol>
    <symbol id="i-last" viewBox="0 0 24 24"><path d="m6 4 8 8-8 8M18 4v16"></path></symbol>
    <symbol id="i-theme" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8.5"></circle>
      <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none"></path>
    </symbol>

  </defs>
</svg>
