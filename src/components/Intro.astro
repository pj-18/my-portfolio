---
/**
 * A film-leader countdown (3 · 2 · 1) that plays once per visit.
 * Skipped entirely with reduced motion, and tap / Enter / Esc cuts straight to the feature.
 * If the script never runs, the CSS still fades it out on its own.
 */
---

<div class="leader" data-leader aria-hidden="true">
  <div class="leader__frame">
    <div class="leader__sweep"></div>
    <svg class="leader__dial" viewBox="0 0 400 400" focusable="false">
      <circle cx="200" cy="200" r="190"></circle>
      <circle cx="200" cy="200" r="152"></circle>
      <path d="M0 200H400M200 0V400"></path>
    </svg>
    <ol class="leader__digits">
      <li>3</li>
      <li>2</li>
      <li>1</li>
    </ol>
  </div>
  <p class="leader__title">A PJ production</p>
  <button class="leader__skip" type="button" tabindex="-1">Skip intro</button>
</div>

<style is:global>
  .leader {
    display: none;
  }

  .intro .leader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.6rem;
    background: #0b0a08;
    color: var(--paper);
    animation: leader-out 0.45s ease 2.5s forwards;
  }

  /* scratches and a little projector flicker */
  .intro .leader::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 23%, rgb(243 234 216 / 0.07) 23.1%, transparent 23.3%),
      linear-gradient(90deg, transparent 71%, rgb(243 234 216 / 0.05) 71.1%, transparent 71.2%);
    animation: scratch 0.24s steps(2) infinite;
    pointer-events: none;
  }

  .intro .leader::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff6df;
    opacity: 0;
    animation: leader-flash 0.4s ease-out 2.4s;
    pointer-events: none;
  }

  .leader.is-skipping {
    animation: leader-out 0.28s ease forwards;
  }

  .leader__frame {
    position: relative;
    display: grid;
    place-items: center;
    width: min(76vw, 25rem);
    aspect-ratio: 1;
    animation: flicker 0.16s steps(2) infinite;
  }

  .leader__sweep {
    position: absolute;
    inset: 5%;
    border-radius: 50%;
    background: conic-gradient(rgb(243 234 216 / 0.2) var(--sweep), transparent 0);
    animation: leader-sweep 0.8s linear 3;
  }

  .leader__dial {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(243 234 216 / 0.55);
    stroke-width: 2;
  }

  .leader__digits {
    display: grid;
  }

  .leader__digits li {
    grid-area: 1 / 1;
    font-family: var(--f-display);
    font-size: clamp(9rem, 50vw, 17rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 1;
    opacity: 0;
    animation: leader-digit 0.8s steps(1, end) forwards;
  }

  .leader__digits li:nth-child(2) {
    animation-delay: 0.8s;
  }

  .leader__digits li:nth-child(3) {
    animation-delay: 1.6s;
  }

  .leader__title {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--muted);
    animation: leader-fade 0.8s ease 0.2s both;
  }

  .leader__skip {
    position: absolute;
    right: var(--gutter);
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .leader__skip::after {
    content: ' ↵';
  }

  @property --sweep {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes leader-sweep {
    from {
      --sweep: 0deg;
    }
    to {
      --sweep: 360deg;
    }
  }

  @keyframes leader-digit {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes leader-flash {
    0% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes leader-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes leader-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes flicker {
    50% {
      opacity: 0.9;
    }
  }

  @keyframes scratch {
    50% {
      transform: translateX(14px);
    }
  }
</style>

<script>
  import '../scripts/intro';
</script>
