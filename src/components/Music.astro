---
import ReelHead from './ReelHead.astro';
import Icon from './Icon.astro';
import { charts, firstChart, isSample, lastPlayed, music, sized, sizes } from '../lib/music';
import { site } from '../site.config';
import { dayMonthYear } from '../lib/util';

const count = new Intl.NumberFormat('en-GB');
const since = music?.since ? new Date(music.since).getUTCFullYear() : null;
const initials = (name: string) =>
  name
    .split(/[\s.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase();
const cued = firstChart?.cuts.find((cut) => cut.preview) ?? firstChart?.cuts[0];
const hasPreviews = charts.some((chart) => chart.cuts.some((cut) => cut.preview));
const opening = firstChart?.key;
const pressed = (on: boolean) => (on ? 'true' : 'false');
/* "Last spun" links to Apple Music when it can; otherwise it's just a card. */
const Spun = lastPlayed?.apple ? 'a' : 'div';
const spunProps = lastPlayed?.apple ? { href: lastPlayed.apple, target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  music && firstChart && (
    <section
      id="music"
      class="reel music"
      data-scene="music"
      aria-labelledby="music-title"
      data-music
      data-owner={site.nickname}
    >
      <ReelHead
        id="music-title"
        number="02"
        title="The soundtrack"
        kicker="Apple Music"
        accent="cyan"
        symbol="♪"
        variant="optical"
        speed={44}
      />

      <div class="wrap music__intro">
        {isSample && (
          <p class="music__sample" role="note">
            <b>Sample line-up.</b> This only shows in <code>npm run dev</code>. Add your Last.fm username and API key
            (see the README) and your own charts take its place.
          </p>
        )}
        <p class="lede reveal">
          What's on repeat: my Apple Music plays, pressed onto a record.
          {hasPreviews && ' Tap a song for thirty seconds of it.'}
        </p>
        <div class="music__tools reveal">
          {charts.length > 1 && (
            <div class="period" role="group" aria-label="Chart period" data-periods>
              {charts.map((chart) => (
                <button type="button" data-period={chart.key} aria-pressed={pressed(chart.key === opening)}>
                  {chart.label}
                </button>
              ))}
            </div>
          )}
          <dl class="meter">
            {music.scrobbles && (
              <div>
                <dt>Plays</dt>
                <dd>{count.format(music.scrobbles)}</dd>
              </div>
            )}
            {music.artistCount && (
              <div>
                <dt>Artists</dt>
                <dd>{count.format(music.artistCount)}</dd>
              </div>
            )}
            {since && (
              <div>
                <dt>Since</dt>
                <dd>{since}</dd>
              </div>
            )}
          </dl>
        </div>
      </div>

      <div class="wrap music__body">
        {/* ---------- the line-up: top artists as a gig poster ---------- */}
        <div class="block">
          <h3 class="sub reveal">
            The line-up <span>Top artists</span>
          </h3>
          <div class="reveal">
            {charts.map((chart) => (
              <article
                class="poster"
                data-chart={chart.key}
                hidden={chart.key !== opening}
                aria-label={`Top ${chart.acts.length} artists, ${chart.long}`}
              >
                <p class="poster__top" aria-hidden="true">
                  <span>{site.nickname}'s rotation presents</span>
                  <span>{chart.long}</span>
                </p>

                <div class="spot" aria-live="polite">
                  {chart.acts.map((act, i) => (
                    <figure class="spot__panel" data-spot={i} hidden={i !== 0}>
                      <div class="spot__photo">
                        {act.picture ? (
                          <img
                            src={sized(act.picture, 500)}
                            srcset={sizes(act.picture, [250, 500, 1000])}
                            sizes="(min-width: 48rem) 40vw, 92vw"
                            width="500"
                            height="500"
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="spot__mono" aria-hidden="true">
                            {initials(act.name)}
                          </span>
                        )}
                      </div>
                      <figcaption class="spot__caption">
                        <span class="spot__name">{act.name}</span>
                        {act.favourite && (
                          <span class="spot__meta">
                            <span>on repeat: “{act.favourite.name}”</span>
                          </span>
                        )}
                      </figcaption>
                    </figure>
                  ))}
                </div>

                <div class="bill-wrap">
                  <ol class="bill">
                    {chart.acts.map((act, i) => (
                      <li
                        class:list={[
                          'bill__act',
                          `tier-${act.tier}`,
                          i < chart.acts.length - 1 && act.tier !== chart.acts[i + 1].tier && 'ends-tier',
                        ]}
                      >
                        <button
                          type="button"
                          data-act={i}
                          aria-pressed={pressed(i === 0)}
                          style={`--len:${Math.max(4, act.name.length)}`}
                        >
                          {act.name}
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>

                <p class="poster__fine" aria-hidden="true">
                  Gates open whenever the headphones go on · Plays counted by the needle · No refunds
                </p>
              </article>
            ))}
          </div>
        </div>

        {/* ---------- the turntable: top songs as a two-sided record ---------- */}
        <div class="block turntable">
          <h3 class="sub reveal">
            On the turntable <span>Top songs</span>
          </h3>

          <div class="deck reveal" data-deck>
            <div class="deck__plinth">
              <span class="deck__platter" aria-hidden="true" />
              <div class="record" data-record aria-hidden="true">
                <img
                  class="record__label"
                  data-label
                  src={sized(cued?.art, 400) ?? undefined}
                  alt=""
                  width="400"
                  height="400"
                  hidden={!cued?.art}
                  decoding="async"
                />
                <span class="record__blank" data-label-blank hidden={!!cued?.art}>
                  {site.nickname}
                </span>
              </div>
              <span class="deck__sheen" aria-hidden="true" />
              <svg class="tonearm" viewBox="0 0 60 200" aria-hidden="true" focusable="false">
                <defs>
                  <linearGradient id="arm-metal" x1="0" x2="1">
                    <stop offset="0" stop-color="#8d8a84" />
                    <stop offset="0.45" stop-color="#e8e4dc" />
                    <stop offset="1" stop-color="#7b7870" />
                  </linearGradient>
                </defs>
                <rect x="22" y="0" width="16" height="11" rx="3" fill="#3b3833" />
                <circle cx="30" cy="22" r="15" fill="#24221e" stroke="#4a463f" />
                <circle cx="30" cy="22" r="6.5" fill="url(#arm-metal)" />
                <path d="M30 22 L30 150 L21 171" fill="none" stroke="url(#arm-metal)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="11" y="166" width="15" height="22" rx="2.5" transform="rotate(24 18 177)" fill="#2e2c28" stroke="#6e6a62" />
              </svg>
              <span class="deck__rest" aria-hidden="true" />
              <span class="deck__rpm" aria-hidden="true">
                33⅓ RPM
              </span>
              <span class="deck__led" aria-hidden="true" />
            </div>

            <div class="deck__bar">
              <button type="button" class="deck__play" data-toggle aria-label="Play preview" disabled={!hasPreviews}>
                <svg class="deck__icon deck__icon--play" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5.5v13l10.5-6.5z" />
                </svg>
                <svg class="deck__icon deck__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" />
                </svg>
              </button>
              <div class="deck__readout">
                <p class="deck__state">
                  <span data-now-state>Cued up</span> · <span data-now-code>{cued?.code}</span>
                  <span class="deck__time" data-time aria-hidden="true" />
                </p>
                <p class="deck__title" data-now-title>
                  {cued?.name}
                </p>
                <p class="deck__artist" data-now-artist>
                  {cued?.artist}
                </p>
              </div>
              <a
                class="deck__out"
                data-now-link
                href={cued?.apple ?? undefined}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={cued ? `${cued.name} on Apple Music` : 'Open the cued song'}
                hidden={!cued?.apple}
              >
                <Icon name="arrow" size={18} />
              </a>
            </div>
            <p class="sr-only" aria-live="polite" data-announce />
          </div>

          <div class="reveal">
            {charts.map((chart) => (
              <div class="sides" data-chart={chart.key} hidden={chart.key !== opening}>
                {(['A', 'B'] as const).map((side) => {
                  const cuts = chart.cuts.filter((cut) => cut.side === side);
                  const top = Math.max(1, ...chart.cuts.map((cut) => cut.plays));
                  return (
                    cuts.length > 0 && (
                      <div class="side">
                        <p class="side__label">
                          <span class="side__disc" aria-hidden="true" />
                          Side {side}
                        </p>
                        <ol class="tracks">
                          {cuts.map((cut) => (
                            <li class="track" style={`--share:${(cut.plays / top).toFixed(3)}`}>
                              <button
                                type="button"
                                class="track__btn"
                                data-track
                                data-code={cut.code}
                                data-name={cut.name}
                                data-artist={cut.artist}
                                data-art={sized(cut.art, 400) ?? ''}
                                data-art-big={sized(cut.art, 600) ?? ''}
                                data-preview={cut.preview ?? ''}
                                data-link={cut.apple ?? ''}
                                aria-pressed="false"
                              >
                                <span class="track__code" aria-hidden="true">
                                  <span class="track__no">{cut.code}</span>
                                  <span class="track__eq">
                                    <i />
                                    <i />
                                    <i />
                                  </span>
                                </span>
                                <span class="track__art" aria-hidden="true">
                                  {cut.art ? (
                                    <img
                                      src={sized(cut.art, 120)}
                                      srcset={sizes(cut.art, [60, 120])}
                                      sizes="44px"
                                      width="44"
                                      height="44"
                                      alt=""
                                      loading="lazy"
                                      decoding="async"
                                    />
                                  ) : (
                                    <span>♪</span>
                                  )}
                                </span>
                                <span class="track__text">
                                  <span class="sr-only">{cut.preview ? 'Play a preview of ' : 'Cue '}</span>
                                  <span class="track__name">{cut.name}</span>
                                  <span class="sr-only"> by </span>
                                  <span class="track__artist">{cut.artist}</span>
                                </span>
                                <span class="track__plays">
                                  {count.format(cut.plays)}
                                  <small> plays</small>
                                </span>
                              </button>
                              {cut.apple ? (
                                <a
                                  class="track__out"
                                  href={cut.apple}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  aria-label={`${cut.name} on Apple Music`}
                                >
                                  <Icon name="arrow" size={16} />
                                </a>
                              ) : (
                                <span class="track__out" aria-hidden="true" />
                              )}
                            </li>
                          ))}
                        </ol>
                      </div>
                    )
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>

      {lastPlayed && (
        <div class="wrap music__foot reveal">
          <Spun class="spun" {...spunProps}>
            {lastPlayed.art ? (
              <img
                class="spun__art"
                src={sized(lastPlayed.art, 120)}
                width="44"
                height="44"
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="spun__art spun__art--blank" aria-hidden="true">
                ♪
              </span>
            )}
            <span class="spun__text">
              <span class="spun__label">
                <span class="spun__dot" />
                {lastPlayed.nowPlaying ? 'Spinning at the last sync' : 'Last spun'} ·{' '}
                <time datetime={lastPlayed.at} data-ago>
                  {dayMonthYear(lastPlayed.at)}
                </time>
              </span>
              <span class="spun__title">
                {lastPlayed.name} <span>— {lastPlayed.artist}</span>
              </span>
            </span>
          </Spun>
        </div>
      )}
    </section>
  )
}

<style>
  .music {
    --cyan-dim: #a8dbe6;
    --violet: #6a4cff;
  }

  .music__intro {
    display: grid;
    gap: 1.5rem;
  }

  .music__sample {
    padding: 0.85rem 1rem;
    border: 1px dashed rgb(86 210 238 / 0.5);
    border-radius: 12px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--cyan-dim);
    background: rgb(86 210 238 / 0.05);
  }

  .music__sample b {
    color: var(--cyan);
  }

  .lede {
    max-width: 38ch;
    font-size: clamp(1.2rem, 4.6vw, 1.7rem);
    font-weight: 450;
    line-height: 1.35;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  .music__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .period {
    display: inline-flex;
    padding: 4px;
    border: 1px solid rgb(86 210 238 / 0.3);
    border-radius: 999px;
    background: rgb(6 22 27 / 0.7);
  }

  :global(.no-js) .period {
    display: none;
  }

  .period button {
    min-height: 38px;
    padding: 0 0.95rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--cyan-dim);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .period button[aria-pressed='true'] {
    background: var(--cyan);
    color: #031216;
    font-weight: 700;
  }

  .meter {
    display: flex;
    gap: 1.6rem;
  }

  .meter div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
  }

  .meter dt {
    font-family: var(--f-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .meter dd {
    font-family: var(--f-display);
    font-size: clamp(1.7rem, 7vw, 2.4rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.85;
    color: var(--cyan);
    font-variant-numeric: tabular-nums;
  }

  .music__body {
    display: grid;
    gap: clamp(3.5rem, 10vw, 6rem);
    margin-top: clamp(2.5rem, 8vw, 4rem);
  }

  .sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 10vw, 4rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .sub span {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  /* ---------- the line-up poster ---------- */

  .poster {
    position: relative;
    display: grid;
    gap: 1.1rem;
    padding: 0.9rem 0.9rem 1rem;
    overflow: hidden;
    border: 1px solid rgb(86 210 238 / 0.22);
    border-radius: var(--radius);
    background:
      radial-gradient(rgb(86 210 238 / 0.07) 1px, transparent 1.4px) 0 0 / 7px 7px,
      radial-gradient(120% 70% at 50% 0%, rgb(86 210 238 / 0.1), transparent 65%),
      #0b1013;
  }

  .poster[hidden] {
    display: none;
  }

  .poster__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--f-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  .spot {
    position: relative;
    display: grid;
    border-radius: 10px;
    overflow: hidden;
    background: #061015;
  }

  .spot__panel {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3.4;
    animation: spot-in 0.55s var(--ease-out);
  }

  .spot__panel[hidden] {
    display: none;
  }

  @keyframes spot-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
  }

  /* duotone, like a screen-printed gig poster */
  .spot__photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(165deg, #8ef0ff 0%, var(--cyan) 35%, var(--violet) 100%);
  }

  .spot__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    filter: grayscale(1) contrast(1.15) brightness(1.04);
    mix-blend-mode: multiply;
  }

  .spot__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(rgb(3 18 22 / 0.35) 0.8px, transparent 1.3px) 0 0 / 4px 4px,
      linear-gradient(transparent 38%, rgb(4 10 13 / 0.94) 100%);
  }

  .spot__mono {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--f-display);
    font-size: clamp(5rem, 30vw, 11rem);
    font-stretch: 62%;
    font-weight: 900;
    color: rgb(3 18 22 / 0.55);
  }

  .spot__caption {
    position: relative;
    z-index: 1;
    align-self: end;
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
  }

  .spot__name {
    font-family: var(--f-display);
    font-size: clamp(2rem, 9vw, 3rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .spot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--paper-dim);
  }

  /* the bill: every act, sized by rank */
  .bill-wrap {
    container-type: inline-size;
  }

  .bill {
    padding-block: 0.4rem 0.2rem;
    text-align: center;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .bill__act {
    display: inline;
  }

  /* Each tier gets its own line(s); the small rank numbers keep the names apart. The break
     hangs off the end of a tier rather than the start of the next, so a full line can't
     push it onto a line of its own. */
  .bill__act.ends-tier::after {
    content: '\A';
    white-space: pre;
  }

  .bill button {
    display: inline;
    margin-inline: 0.26em;
    padding: 0.05em 0;
    font-family: var(--f-display);
    font-weight: inherit;
    font-stretch: inherit;
    text-transform: inherit;
    text-align: inherit;
    line-height: inherit;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }

  .bill button:hover {
    text-decoration-color: var(--cyan);
  }

  .bill button[aria-pressed='true'] {
    color: var(--cyan);
  }

  .tier-1 {
    font-stretch: 62%;
    font-weight: 900;
  }

  /* The headliner fills its line: shorter names get bigger type. Archivo at 62% width
     averages ~0.47em per capital; the extra 1.2em is the rank number and the margins. */
  .tier-1 button {
    font-size: clamp(1.6rem, calc(100cqi / (var(--len) * 0.5 + 1.2)), 6.5rem);
    line-height: 0.92;
  }

  .tier-2 {
    font-size: clamp(1.45rem, 8.6cqi, 3.6rem);
    font-stretch: 70%;
    font-weight: 850;
  }

  .tier-3 {
    font-size: clamp(1.1rem, 6cqi, 2.6rem);
    font-stretch: 82%;
    font-weight: 750;
  }

  .tier-4 {
    font-size: clamp(0.92rem, 4.6cqi, 2rem);
    font-stretch: 95%;
    font-weight: 650;
  }

  .tier-1,
  .tier-2 {
    line-height: 1;
  }

  .poster__fine {
    padding-top: 0.8rem;
    border-top: 1px dashed rgb(86 210 238 / 0.25);
    font-family: var(--f-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* ---------- the turntable ---------- */

  .deck {
    display: grid;
    gap: 0.9rem;
  }

  .deck__plinth {
    --arm-rest: 0deg;
    --arm-start: 14deg;
    --arm-end: 36deg;
    position: relative;
    aspect-ratio: 5 / 4;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.012) 0 1px, transparent 1px 3px),
      radial-gradient(90% 70% at 30% 20%, rgb(86 210 238 / 0.07), transparent 70%),
      linear-gradient(150deg, #201e1a, #121110 70%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 24px 50px -20px rgb(0 0 0 / 0.8);
  }

  .deck__platter,
  .record,
  .deck__sheen {
    position: absolute;
    top: 7%;
    left: 8%;
    height: 86%;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .deck__platter {
    top: 5.5%;
    left: 6.8%;
    height: 89%;
    background: radial-gradient(circle, #77746d 0 66%, #a9a59c 68%, #4b4842 70.5%);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.55);
  }

  .record {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle, transparent 0 35%, rgb(255 255 255 / 0.05) 35.5% 36.2%, transparent 36.8%),
      radial-gradient(circle, transparent 0 96%, rgb(255 255 255 / 0.06) 96.5% 97%, transparent 97.5%),
      repeating-radial-gradient(circle, #111 0 1.1px, #1b1b1b 1.5px 2.5px);
    box-shadow:
      0 0 0 1.5px #070707,
      inset 0 0 18px rgb(0 0 0 / 0.6);
  }

  .record__label,
  .record__blank {
    grid-area: 1 / 1;
    width: 36%;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px rgb(0 0 0 / 0.5);
  }

  .record__label[hidden],
