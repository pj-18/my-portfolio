---
import Icon from './Icon.astro';
import { filmUrl, poster, recommendations } from '../lib/films';
import { safeJson } from '../lib/util';

const reel = recommendations.map((e) => {
  const art = poster(e.poster);
  return {
    title: e.title,
    year: e.year,
    rating: e.rating,
    liked: e.liked,
    src: art?.src ?? null,
    srcset: art?.srcset ?? null,
    url: filmUrl(e),
    take: e.review[0]?.replace(/\s*\n\s*/g, ' ') ?? null,
  };
});
---

{
  reel.length > 0 && (
    <section class="wrap post" data-scene="films" aria-labelledby="post-title">
      <p class="eyebrow post__kicker">
        <span /> Post-credits scene
      </p>
      <h3 id="post-title" class="post__title">Can't pick tonight's film?</h3>
      <p class="post__text">Spin the reel. It only stops on films I loved or rated three and a half stars or more.</p>
      <div class="spinner" data-spinner>
        <div class="spinner__gate" aria-hidden="true">
          <img data-spin-img alt="" width="300" height="450" hidden />
          <span class="spinner__leader">?</span>
        </div>
        <div class="spinner__result" aria-live="polite" data-spin-result>
          <p class="spinner__idle">The projector is loaded. Press the button.</p>
        </div>
      </div>
      <button type="button" class="pill pill--solid accent-violet post__spin" data-spin>
        <Icon name="shuffle" /> Spin the reel
      </button>
      <script type="application/json" id="reel-data" is:inline set:html={safeJson(reel)} />
    </section>
  )
}

<style>
  .post {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    margin-block: clamp(0.75rem, 3vw, 2rem);
    padding: 1.25rem 1rem;
    border: 1px dashed rgb(167 139 250 / 0.35);
    border-radius: var(--radius);
    background: radial-gradient(110% 70% at 50% 0%, rgb(167 139 250 / 0.05), transparent 70%);
    text-align: center;
  }

  .post__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post__kicker span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--violet);
  }

  .post__title {
    font-family: var(--f-display);
    font-size: clamp(1.8rem, 8vw, 3rem);
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .post__text {
    max-width: 34ch;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .spinner {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    width: 100%;
    margin-block: 0.25rem 0;
  }

  .spinner__gate {
    position: relative;
    display: grid;
    place-items: center;
    width: 6.5rem;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle, transparent 38%, rgb(243 234 216 / 0.14) 39%, transparent 40%),
      repeating-linear-gradient(0deg, var(--ink-3) 0 6px, var(--ink-2) 6px 12px);
    box-shadow:
      0 0 0 6px var(--ink-2),
      0 0 0 7px var(--line-2),
      0 24px 40px -18px rgb(0 0 0 / 0.9);
  }

  .spinner__gate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* the strip of posters that rolls through the gate while spinning */
  .spinner__gate :global(.spinner__reel) {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    flex-direction: column;
    will-change: transform, filter;
  }

  .spinner__gate :global(.spinner__reel[hidden]) {
    display: none;
  }

  .spinner__gate :global(.spinner__reel img) {
    position: static;
    flex: none;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: var(--ink-3);
  }

  /* gate shadow so the frames read as passing behind the aperture */
  .spinner__gate::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: linear-gradient(rgb(0 0 0 / 0.55), transparent 22%, transparent 78%, rgb(0 0 0 / 0.55));
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .spinner.is-spinning .spinner__gate::after {
    opacity: 1;
  }

  .spinner__leader {
    font-family: var(--f-display);
    font-size: 3.2rem;
    font-stretch: 62%;
    font-weight: 850;
    color: var(--dim);
  }

  .spinner__result {
    display: grid;
    gap: 0.35rem;
    max-width: 32ch;
  }

  .spinner__idle {
    color: var(--dim);
    font-family: var(--f-serif);
    font-size: 1.1rem;
    font-style: italic;
  }

  .spinner__result :global(.spin-title) {
    font-family: var(--f-display);
    font-size: 1.9rem;
    font-stretch: 62%;
    font-weight: 820;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .spinner__result :global(.spin-title span) {
    color: var(--muted);
    font-weight: 500;
  }

  .spinner__result :global(.spin-stars) {
    color: var(--violet);
    line-height: 1;
  }

  .spinner__result :global(.spin-heart) {
    margin-left: 0.5em;
    color: var(--red);
  }

  .spinner__result :global(.spin-take) {
    font-family: var(--f-serif);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--paper-dim);
  }

  .spinner__result :global(.spin-link) {
    justify-self: center;
    margin-top: 0.3rem;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet);
  }

  @media (min-width: 48rem) {
    .post {
      grid-template-columns: auto minmax(0, 1fr);
      justify-items: start;
      align-content: center;
      gap: 0.8rem 2.25rem;
      width: min(100% - 2 * var(--gutter), 52rem);
      padding: 1.75rem 2rem;
      text-align: left;
    }

    .post > :not(.spinner) {
      grid-column: 2;
    }

    .post__text {
      font-size: 1rem;
    }

    /* four rows of copy beside it: kicker, title, text, button */
    .spinner {
      grid-column: 1;
      grid-row: 1 / span 4;
      justify-items: center;
      margin: 0;
    }

    .spinner__gate {
      width: 7.5rem;
    }

    .spinner__result :global(.spin-link) {
      justify-self: center;
    }
  }
</style>

<script>
  import '../scripts/post-credits';
</script>
