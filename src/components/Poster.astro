---
import { Picture } from 'astro:assets';
import type { Film } from '../lib/films';

/**
 * A film poster at 2:3. The box takes the poster's dominant colour while the
 * image loads, and falls back to a typeset tile if the poster was not fetched.
 */
interface Props {
  film: Film;
  /** Candidate widths in pixels and the matching `sizes` attribute. */
  widths: number[];
  sizes: string;
  /** Load eagerly only for posters likely to be on screen straight away. */
  loading?: 'lazy' | 'eager';
}
const { film, widths, sizes, loading = 'lazy' } = Astro.props;
---

<div class="poster" style={film.posterColor ? `background-color:${film.posterColor}` : undefined}>
  {
    film.image ? (
      <Picture
        src={film.image}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        alt={`Poster for ${film.title}`}
        loading={loading}
        decoding="async"
      />
    ) : (
      <p class="poster__blank" aria-hidden="true">
        {film.title}
      </p>
    )
  }
</div>

<style>
  .poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background-color: var(--zone-2);
  }

  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster__blank {
    display: grid;
    align-content: end;
    height: 100%;
    padding: 8%;
    font-size: 0.8125rem;
    font-stretch: 62%;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    color: var(--yellow);
    overflow-wrap: anywhere;
  }
</style>
