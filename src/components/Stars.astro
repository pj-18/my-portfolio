---
/** A rating out of five, in half steps, drawn as stars with a text equivalent. */
interface Props {
  rating: number;
}

const { rating } = Astro.props;
const whole = Math.floor(rating);
const hasHalf = rating - whole >= 0.5;

// A five-pointed star centred in a 20 x 20 box; the half star is its left side.
const point = (radius: number, degrees: number) => {
  const angle = (degrees * Math.PI) / 180;
  return `${(10 + radius * Math.cos(angle)).toFixed(2)} ${(10.6 + radius * Math.sin(angle)).toFixed(2)}`;
};
const OUTER = 9.4;
const INNER = 3.9;
const corners = Array.from({ length: 10 }, (_, i) => point(i % 2 === 0 ? OUTER : INNER, -90 + i * 36));
const star = `M${corners.join('L')}Z`;
const leftHalf = `M${[corners[0], ...corners.slice(5)].join('L')}Z`;
---

<span class="stars" role="img" aria-label={`Rated ${rating} out of 5`}>
  <svg viewBox="0 0 100 20" width="80" height="16" aria-hidden="true" focusable="false">
    {
      [0, 1, 2, 3, 4].map((i) => (
        <g transform={`translate(${i * 20} 0)`}>
          <path class={i < whole ? 'stars__on' : 'stars__off'} d={star} />
          {i === whole && hasHalf && <path class="stars__on" d={leftHalf} />}
        </g>
      ))
    }
  </svg>
</span>

<style is:global>
  .stars {
    display: inline-block;
    vertical-align: middle;
  }

  .stars__on {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .stars__off {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-linejoin: round;
  }
</style>
