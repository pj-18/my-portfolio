---
/**
 * Work: a short bio (content/bio.md), skills (content/skills.json), the experience timeline
 * (content/experience/*.md) and selected projects (content/projects/*.md).
 */
import { getCollection, render } from 'astro:content';
import { Content as Bio } from '../../content/bio.md';
import skills from '../../content/skills.json';
import { estimates } from '../lib/estimate.ts';
import { pad2 } from '../lib/format.ts';
import Chapter from './Chapter.astro';
import Icon from './Icon.astro';

// Newest role first; a role with no end date is the current one.
const roles = await Promise.all(
  (await getCollection('experience'))
    .sort((a, b) => b.data.start.localeCompare(a.data.start))
    .map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);

const projects = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
    .map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);

const year = (value: string) => value.slice(0, 4);
---

<section class="section" id="work" aria-labelledby="work-title" style={estimates.work(roles.length, projects.length)}>
  <div class="wrap">
    <Chapter id="work" />

    <div class="about">
      <div class="about__bio prose" data-reveal>
        <Bio />
      </div>

      <dl class="skills" data-reveal>
        {
          skills.groups.map((group) => (
            <div class="skills__group">
              <dt class="label muted">{group.name}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <h3 class="subhead label">Experience</h3>
    <ol class="roles defer" style={estimates.roles(roles.length)}>
      {
        roles.map((role) => (
          <li class="role" data-reveal>
            <p class="role__dates label">
              <time datetime={role.start}>{year(role.start)}</time>
              <span aria-hidden="true"> — </span>
              <span class="visually-hidden">to</span>
              {role.end ? <time datetime={role.end}>{year(role.end)}</time> : <span>Now</span>}
            </p>

            <div class="role__body">
              <h4 class="role__title">
                {role.role}
                <span class="role__company">
                  <span class="visually-hidden">at</span>
                  {role.companyUrl ? <a href={role.companyUrl}>{role.company}</a> : role.company}
                </span>
              </h4>
              <div class="prose role__text">
                <role.Content />
              </div>
            </div>

            <div class="role__aside label muted">
              {role.location && <p>{role.location}</p>}
              {role.stack.length > 0 && (
                <ul class="tags" aria-label="Technologies">
                  {role.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <h3 class="subhead label projects__head">Selected projects</h3>
    <ul class="projects defer" style={estimates.projects(projects.length)}>
      {
        projects.map((project, i) => (
          <li class="project" data-reveal>
            <p class="project__meta label muted">
              <span aria-hidden="true">{pad2(i + 1)}</span>
              {project.role && <span>{project.role}</span>}
              {project.year && <span class="project__year">{project.year}</span>}
            </p>
            <h4 class="project__title">{project.title}</h4>
            <div class="prose project__text">
              <project.Content />
            </div>
            {project.stack.length > 0 && (
              <ul class="tags label muted" aria-label="Technologies">
                {project.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {project.links.length > 0 && (
              <ul class="project__links label">
                {project.links.map((link) => (
                  <li>
                    <a href={link.url}>
                      {link.label}
                      <span class="visually-hidden">: {project.title}</span>
                      <Icon />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  /* ── Bio and skills ── */

  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem) var(--gap);
    margin-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .about__bio {
    max-width: 34em;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .skills {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .skills__group {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }

  /* ── Experience ── */

  .roles {
    margin: 0 0 clamp(3.5rem, 8vw, 6.5rem);
  }

  .role {
    display: grid;
    gap: 0.6rem var(--gap);
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
  }

  .role:first-child {
    padding-top: 0;
  }

  .role__dates {
    color: var(--accent);
    white-space: nowrap;
  }

  .role__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.25;
  }

  .role__company {
    display: block;
    font-weight: 400;
    font-style: italic;
    color: var(--muted);
  }

  .role__text {
    margin-top: 0.75rem;
    max-width: 38em;
  }

  .role__aside {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
    margin: 0;
  }

  .tags li:not(:last-child)::after {
    content: '/';
    margin-inline-start: 0.5rem;
    color: var(--line-strong);
  }

  /* ── Projects ── */

  .projects {
    display: grid;
    gap: 0 var(--gap);
    margin: 0;
  }

  .project {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-block: 1rem clamp(1.75rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .project__meta {
    display: flex;
    gap: 1rem;
  }

  .project__meta span:first-child {
    color: var(--accent);
  }

  .project__year {
    margin-inline-start: auto;
  }

  .project__title {
    margin-top: 0.5rem;
    font-size: var(--step-2);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .project__text {
    max-width: 34em;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0.25rem 0 0;
  }

  .project__links a {
    display: inline-flex;
    align-items: center;
    padding-block: 0.3rem;
  }

  .project__links a:hover .icon {
    translate: 0.12em -0.12em;
  }

  @media (min-width: 48em) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60em) {
    .about,
    .role {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .about__bio {
      grid-column: 1 / span 7;
    }
    .skills {
      grid-column: 9 / -1;
    }
    .role__dates {
      grid-column: 1 / span 2;
      padding-top: 0.35em;
    }
    .role__body {
      grid-column: 3 / span 6;
    }
    .role__aside {
      grid-column: 10 / -1;
      padding-top: 0.35em;
    }
  }
</style>
