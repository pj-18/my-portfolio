---
import ReelHead from './ReelHead.astro';
import { site } from '../site.config';
import { stats } from '../lib/films';
import { music } from '../lib/music';
import {
  siCss,
  siCucumber,
  siCursor,
  siCypress,
  siGit,
  siGithubactions,
  siHtml5,
  siJavascript,
  siJira,
  siNodedotjs,
  siPostman,
  siReact,
  siSelenium,
  siTypescript,
} from 'simple-icons';
import { rich } from '../lib/util';

const about = rich(site.about);
const tests = site.tests.map((t) => ({
  ...t,
  name: t.name.replace('{films}', String(stats.logged)).replace('{reviews}', String(stats.reviews)),
}));
/* ---- a logo for each tool in the ticker ----
   Brand marks come from Simple Icons (CC0). Playwright and VS Code aren't in it any more, so
   those are drawn by hand; SQL, REST and CI/CD have no brand mark, so those get a small glyph in the section's green. */
type Logo = { color: string; body: string; stroke?: boolean };
const brand = (icon: { hex: string; path: string }): Logo => ({ color: `#${icon.hex}`, body: `<path d="${icon.path}"/>` });
const drawn = (body: string): Logo => ({ color: 'var(--green)', body, stroke: true });
const logos: Record<string, Logo> = {
  react: brand(siReact),
  javascript: brand(siJavascript),
  typescript: brand(siTypescript),
  cypress: brand(siCypress),
  postman: brand(siPostman),
  'node.js': brand(siNodedotjs),
  git: brand(siGit),
  selenium: brand(siSelenium),
  cucumber: brand(siCucumber),
  html: brand(siHtml5),
  css: brand(siCss),
  'github actions': brand(siGithubactions),
  jira: brand(siJira),
  // Cursor's mark is black: on this dark scene it takes the paper colour
  cursor: { ...brand(siCursor), color: 'var(--paper)' },
  // VS Code's mark: the blue ribbon (Simple Icons no longer carries it)
  'vs code': {
    color: '#007ACC',
    body: '<path d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/>',
  },
  // Playwright's mark: two theatre masks, red behind green
  playwright: {
    color: '#2EAD33',
    body:
      '<path fill="#E2574C" fill-rule="evenodd" transform="rotate(-14 8 9)" d="M2.5 3.5h11v5a5.5 5.5 0 0 1-11 0zM5 6.2a1 1 0 1 0 2 0a1 1 0 1 0-2 0zm4 0a1 1 0 1 0 2 0a1 1 0 1 0-2 0zM5.2 11.6a2.8 2.8 0 0 1 5.6 0z"/>' +
      '<path fill="currentColor" fill-rule="evenodd" stroke="var(--ink)" stroke-width="1.4" paint-order="stroke" d="M9.5 9h12v5.5a6 6 0 0 1-12 0zM12.4 11.6a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0-2.2 0zm4.4 0a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0-2.2 0zM12.5 14.6h6a3 3 0 0 1-6 0z"/>',
  },
  sql: drawn('<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>'),
  'rest apis': drawn(
    '<path d="M8 3H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h1M16 3h1a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-1"/>',
  ),
  'ci/cd': drawn('<path d="M12 12c-2-2.7-4-4-6-4a4 4 0 0 0 0 8c2 0 4-1.3 6-4zm0 0c2 2.7 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.3-6 4z"/>'),
};
const stack = [...site.stack, ...site.stack].map((name) => ({ name, logo: logos[name.toLowerCase()] }));
---

<section id="work" class="reel work" data-scene="work" aria-labelledby="work-title">
  <ReelHead id="work-title" number={music ? '04' : '03'} title="The day job" kicker="Software engineering" accent="green" />

  <div class="wrap work__body">
    <p class="about reveal">
      {
        about.map((part) =>
          part.kind === 'hl' ? (
            <span class={`about__hl accent-${part.accent}`}>{part.text}</span>
          ) : part.kind === 'em' ? (
            <em class="about__em">{part.text}</em>
          ) : (
            part.text
          ),
        )
      }
    </p>

    <figure class="runner reveal" data-runner>
      <div class="runner__bar" aria-hidden="true">
        <span class="runner__tab">zsh — pj@portfolio: ~/career</span>
      </div>
      <div class="runner__screen">
        <p class="runner__cmd" aria-hidden="true">
          <span class="runner__prompt">$</span> npx playwright test <span class="runner__flag">--project=pj</span>
        </p>
        <p class="runner__meta">Running {tests.length} tests using 1 worker</p>
        <ol class="runner__tests">
          {
            tests.map((test, i) => (
              <li style={`--i:${i}`}>
                <span class="runner__state" aria-hidden="true">
                  <span class="runner__pending" />
                  <svg class="runner__pass" viewBox="0 0 16 16" focusable="false">
                    <path d="M3.5 8.5l3 3 6-7" />
                  </svg>
                </span>
                <span class="runner__name">{test.name}</span>
                <span class="runner__time">({test.time})</span>
              </li>
            ))
          }
        </ol>
        <p class="runner__sum" style={`--i:${tests.length}`}>
          <b>{tests.length} passed</b> <span>({tests[0]?.time ?? '0s'})</span><span class="runner__cursor" aria-hidden="true"></span>
        </p>
      </div>
      <figcaption class="sr-only">A test run: all {tests.length} tests passed.</figcaption>
    </figure>
  </div>

  <div class="stack" aria-label="Tools I work with">
    <ul class="sr-only">{site.stack.map((tool) => <li>{tool}</li>)}</ul>
    <div class="stack__track" aria-hidden="true">
      {
        stack.map(({ name, logo }) => (
          <span class="stack__item">
            {logo ? (
              <svg
                class="stack__logo"
                viewBox="0 0 24 24"
                style={`color:${logo.color}`}
                fill={logo.stroke ? 'none' : 'currentColor'}
                stroke={logo.stroke ? 'currentColor' : undefined}
                stroke-width={logo.stroke ? 2 : undefined}
                stroke-linecap={logo.stroke ? 'round' : undefined}
                stroke-linejoin={logo.stroke ? 'round' : undefined}
                focusable="false"
                set:html={logo.body}
              />
            ) : (
              <i>✳</i>
            )}
            {name}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work__body {
    display: grid;
    gap: clamp(2.5rem, 7vw, 4.5rem);
  }

  /* A lighter, softer paragraph so the highlighted words and the serif italics carry the emphasis. */
  .about {
    font-size: clamp(1.5rem, 6.2vw, 3rem);
    font-weight: 380;
    font-optical-sizing: auto;
    line-height: 1.24;
    letter-spacing: -0.022em;
    color: var(--paper-dim);
    text-wrap: pretty;
    hanging-punctuation: first;
  }

  .about__hl {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .about__em {
    color: var(--paper);
    font-family: var(--f-serif);
    font-size: 1.18em;
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.005em;
  }

  /* ---- the test runner ---- */

  .runner {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #0a0a08;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }

  .runner__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--ink-2);
  }

  .runner__tab {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .runner__screen {
    padding: 1.1rem 1rem 1.3rem;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .runner__cmd {
    color: var(--paper);
  }

  .runner__prompt {
    color: var(--green);
  }

  .runner__flag {
    color: var(--cyan);
  }

  .runner__meta {
    margin: 0.4rem 0 0.8rem;
    color: var(--dim);
  }

  .runner__tests li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.6rem;
    padding-block: 0.12rem;
  }

  .runner__state {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.25rem;
  }

  .runner__pending {
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid var(--dim);
    border-radius: 50%;
  }

  .runner__pass {
    position: absolute;
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: var(--green);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
  }

  .runner__name {
    color: var(--dim);
  }

  .runner__time {
    color: var(--dim);
    white-space: nowrap;
  }

  .runner__sum {
    margin-top: 0.9rem;
    color: var(--dim);
    opacity: 0;
  }

  .runner__sum b {
    color: var(--green);
    font-weight: 700;
  }

  .runner__cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.4rem;
    vertical-align: -0.15em;
    background: var(--paper);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* the run: each test flips from pending to pass in sequence */
  .runner__pending,
  .runner__pass,
  .runner__name,
  .runner__time,
  .runner__sum {
    transition:
      opacity 0.25s ease,
      color 0.25s ease;
    transition-delay: calc(0.5s + var(--i, 0) * 0.32s);
  }

  :global(.is-run) .runner__pending {
    opacity: 0;
  }

  :global(.is-run) .runner__pass,
  :global(.is-run) .runner__sum {
    opacity: 1;
  }

  :global(.is-run) .runner__name {
    color: var(--paper);
  }

  :global(.is-run) .runner__time {
    color: var(--muted);
  }

  :global(.no-js) .runner__pass,
  :global(.no-js) .runner__sum {
    opacity: 1;
  }

  :global(.no-js) .runner__pending {
    opacity: 0;
  }

  /* ---- stack ticker ---- */

  .stack {
    position: relative;
    margin-block: clamp(3rem, 9vw, 6rem);
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .stack__track {
    display: flex;
    width: max-content;
    animation: marquee 36s linear infinite reverse;
  }

  /* the ticker closes the reel: no extra gap before the credits */
  .stack:last-child {
    margin-bottom: 0;
  }

  .stack__item {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding-right: 1.1em;
    /* the serif italic of the about text: reads like a film's credits, not a spec sheet */
    font-family: var(--f-serif);
    font-size: clamp(1.9rem, 7vw, 3.1rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.005em;
    color: var(--paper);
    white-space: nowrap;
  }

  .stack__item i {
    font-style: normal;
    font-size: 0.6em;
    color: var(--green);
  }

  .stack__logo {
    flex: none;
    width: 0.7em;
    height: 0.7em;
  }

  @media (min-width: 48rem) {
    .runner__screen {
      padding: 1.4rem 1.5rem 1.6rem;
      font-size: 0.85rem;
    }
  }

  @media (min-width: 64rem) {
    .work__body {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
      gap: 4rem;
    }

    .about {
      font-size: clamp(2rem, 2.9vw, 2.9rem);
    }

    .runner {
      margin-top: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack__track,
    .runner__cursor {
      animation: none;
    }

    .runner__pending,
    .runner__pass,
    .runner__name,
    .runner__time,
    .runner__sum {
      transition: none;
    }
  }
</style>
