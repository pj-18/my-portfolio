---
/** What the trip's price covers, printed like a ticket. The last page of a trip. */
import Icon from '../Icon.astro';
import type { Trip } from '../../lib/tours';
import { tripRange } from '../../lib/tours';
import { withBase } from '../../lib/util';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
---

<section class="step covered" id="covered" data-step="all" data-rail="covered" aria-labelledby="covered-title">
  <div class="slip reveal">
    <header class="slip__head">
      <p class="slip__admit">Admit one</p>
      <h2 class="slip__title" id="covered-title">What's covered</h2>
      <p class="slip__trip">{trip.title} · {tripRange(trip)}</p>
    </header>
    <span class="slip__perf" aria-hidden="true"></span>
    <div class="slip__cols">
      <div>
        <h3>Included</h3>
        <ul class="slip__list slip__list--in">
          {trip.covered.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3>Not included</h3>
        <ul class="slip__list slip__list--out">
          {trip.notCovered.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <p class="covered__back reveal">
    <a class="pill" href={withBase('tours/')}><Icon name="left" /> All tours</a>
  </p>
</section>

<style>
  .slip {
    position: relative;
    max-width: 34rem;
    border-radius: 14px;
    background: var(--ticket);
    color: var(--ticket-ink);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }

  .slip__head {
    padding: 1.4rem 1.4rem 1.1rem;
  }

  .slip__admit {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(27 25 28 / 0.6);
  }

  .slip__title {
    margin-top: 0.35rem;
    font-family: var(--f-display);
    font-size: clamp(2rem, 8vw, 2.8rem);
    font-stretch: 62%;
    font-weight: 850;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .slip__trip {
    margin-top: 0.5rem;
    font-family: var(--f-serif);
    font-size: 1.1rem;
    font-style: italic;
  }

  /* the tear line, with a notch bitten out of each side */
  .slip__perf {
    position: relative;
    display: block;
    height: 0;
    margin-inline: 1rem;
    border-top: 2px dashed rgb(27 25 28 / 0.28);
  }

  .slip__perf::before,
  .slip__perf::after {
    content: '';
    position: absolute;
    top: -11px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--ink);
  }

  .slip__perf::before {
    left: -27px;
  }

  .slip__perf::after {
    right: -27px;
  }

  .slip__cols {
    display: grid;
    gap: 1.25rem;
    padding: 1.2rem 1.4rem 1.5rem;
  }

  .slip__cols h3 {
    margin-bottom: 0.55rem;
    font-family: var(--f-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .slip__list {
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .slip__list li {
    position: relative;
    padding-left: 1.4rem;
  }

  .slip__list li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--f-mono);
    font-weight: 700;
  }

  .slip__list--in li::before {
    content: '✓';
    color: #1f7a4a;
  }

  .slip__list--out li {
    color: rgb(27 25 28 / 0.7);
  }

  .slip__list--out li::before {
    content: '×';
    color: #b2381f;
  }

  .covered__back {
    margin-top: 1.75rem;
  }

  @media (min-width: 30rem) {
    .slip__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
