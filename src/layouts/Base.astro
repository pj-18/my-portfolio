---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/global.css';
import { site } from '../site.config';
import { withBase } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
  /** Whether the 3·2·1 countdown can play. Only the home page has one; other pages must say false. */
  intro?: boolean;
  /** Where "Skip to content" jumps to. */
  skip?: string;
  /** The scene lighting the page starts in (global.css → .ambient). */
  scene?: string;
}

const {
  title = `${site.name} (${site.nickname})`,
  description = site.description,
  intro = true,
  skip = '#films',
  scene = 'top',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Only the live site counts visits: `npm run dev` and previews never do.
const counter = import.meta.env.PROD && site.goatcounter ? `https://${site.goatcounter}.goatcounter.com/count` : null;
---

<!doctype html>
<html lang="en" class="no-js" data-intro={intro ? 'play' : 'skip'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0c0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Runs before first paint: mark JS as available and decide whether the countdown plays.
      // Pages without the countdown skip it, or their header and dock would stay hidden.
      (function (root) {
        root.classList.remove('no-js');
        root.classList.add('js');
        try {
          var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (root.dataset.intro === 'play' && !calm && !sessionStorage.getItem('pj:intro')) root.classList.add('intro');
        } catch (e) {}
      })(document.documentElement);
    </script>
    {counter && <script is:inline async data-goatcounter={counter} src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body data-scene={scene}>
    <a class="skip" href={skip}>Skip to content</a>
    <div class="ambient" aria-hidden="true">
      <i class="a-top"></i><i class="a-work"></i><i class="a-films"></i><i class="a-music"></i><i class="a-darkroom"></i><i class="a-credits"></i><i class="a-tours"></i>
    </div>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
